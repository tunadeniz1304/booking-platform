generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatarUrl           String?
  role                UserRole             @default(USER)
  /// Oturum dönemi: artırıldığında bu kullanıcının TÜM erişim/yenileme token'ları geçersizleşir
  /// (hesap silme, rol değişimi, şifre sıfırlama — v3#5).
  tokenVersion        Int                  @default(0)
  emailVerifiedAt     DateTime?
  /// Art arda başarısız giriş sayısı ve kilit bitişi (AUTH_LOCKOUT_*).
  failedLoginCount    Int                  @default(0)
  lockedUntil         DateTime?
  deletedAt           DateTime?
  /// Arayüz/e-posta dili (tr|en); kayıt ve girişte NEXT_LOCALE çerezinden güncellenir (P1-12).
  locale              String               @default("tr")
  authTokens          AuthToken[]
  webAuthnCredentials WebAuthnCredential[]
  sessions            UserSession[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookings            Booking[]
  reviews             Review[]
  favorites           Favorite[]
  payments            Payment[]
  properties          Property[]
  listedTransfers     BookingTransfer[]    @relation("transferSeller")
  claimedTransfers    BookingTransfer[]    @relation("transferBuyer")
  priceAlerts         PriceAlert[]
  pushSubscriptions   PushSubscription[]
  /// P1-8: ev sahibinin tanımladığı promosyonlar.
  promotions          Promotion[]
  messages            Message[]
  reviewReports       ReviewReport[]
  /// P1-1 grup sepeti
  carts               Cart[]
}

/// Oturum (yenileme token ailesi) kaydı — P0-4 oturum listesi + uzaktan çıkış.
/// `id` = yenileme ailesi kimliği (erişim token'ında `sid`). Token sırları Redis'te kalır;
/// burada yalnızca görüntüleme/yeni cihaz tespiti için meta veri tutulur.
model UserSession {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// İmzalı `did` çerezinden cihaz kimliği (yeni cihaz bildirimi için).
  deviceId   String?
  userAgent  String?
  /// Kaba IP ipucu (IPv4 /24, IPv6 /64) — tam IP saklanmaz.
  ipHint     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([userId, deviceId])
}

/// P1-12: tarayıcı Web Push aboneliği (uç nokta + ECDH anahtarları). 404/410 dönen abonelik silinir.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Push servisinin uç noktası (yalnızca izinli sağlayıcı alan adları; tekil).
  endpoint      String    @unique
  p256dh        String
  auth          String
  /// Bildirim dili ("tr" | "en").
  locale        String    @default("tr")
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  @@index([userId])
}

enum UserRole {
  USER
  HOST
  ADMIN
}

model Property {
  id                   String                      @id @default(cuid())
  hostId               String
  host                 User                        @relation(fields: [hostId], references: [id])
  title                String
  description          String
  propertyType         PropertyType
  locationId           String
  location             Location                    @relation(fields: [locationId], references: [id])
  amenities            Amenity[]                   @relation("PropertyAmenities")
  /// Oda tipleri (v3 P0-2): satış birimi oda tipidir; `units` adet oda.
  rooms                RoomType[]
  /// IANA saat dilimi; gece, iade penceresi, iCal ve checkout sonrası tamamlama bu dilimde (ADR 0011).
  timeZone             String                      @default("Europe/Istanbul")
  /// Yerel giriş/çıkış saati (SS:DD).
  checkInTime          String                      @default("15:00")
  checkOutTime         String                      @default("11:00")
  bookings             Booking[]
  reviews              Review[]
  favorites            Favorite[]
  basePriceMinor       BigInt
  currency             String                      @default("TRY")
  ratingAvg            Float                       @default(0)
  ratingCount          Int                         @default(0)
  isActive             Boolean                     @default(true)
  images               String[]                    @default([])
  embedding            Unsupported("vector(128)")?
  /// P1-1 hibrit arama: başlık + açıklamadan üretilen tsvector (GENERATED ALWAYS, `simple` +
  /// `turkish` yapılandırması, GIN indeksli). Yalnızca SQL'de okunur; migration'da tanımlı.
  searchVector         Unsupported("tsvector")?
  priceHistory         PriceHistory[]
  /// P1-10: yüklenen fotoğraflar (kalite skoru, pHash, CLIP embedding).
  photos               PropertyPhoto[]
  /// P1-13(e): erişilebilirlik özellikleri (yalnız admin doğrulamalılar herkese gösterilir).
  accessibilityFeatures AccessibilityFeature[]
  /// P1-8: yalnız bu ilana özel promosyonlar (ev sahibi geneli olanlar propertyId=null).
  promotions            Promotion[]
  /// İptal politikası (yoksa varsayılan MODERATE); rezervasyonda snapshot'ı alınır.
  /// Turizm İşletme Belgesi / 7464 izin belgesi no (ör. 34-12345); boşsa ilan yayınlanmaz.
  licenseNumber        String?
  /// P1-10: kayıt no doğrulama durumu (TR 7565 / AB 2024/1028 mock kayıtları). Yayın için VERIFIED şart.
  licenseStatus        LicenseStatus               @default(PENDING)
  licenseCheckedAt     DateTime?
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy?         @relation(fields: [cancellationPolicyId], references: [id])
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([locationId, isActive])
  @@index([hostId])
  @@index([propertyType, isActive])
  @@index([ratingAvg])
}

enum PropertyType {
  HOTEL
  APARTMENT
  VILLA
  HOSTEL
  BED_AND_BREAKFAST
}

model Location {
  id           String        @id @default(cuid())
  city         String
  country      String
  latitude     Float?
  longitude    Float?
  properties   Property[]
  demandEvents DemandEvent[]

  @@unique([city, country])
  @@index([city])
  @@index([country])
}

model DemandEvent {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id])
  title      String
  startsAt   DateTime          @db.Date
  endsAt     DateTime          @db.Date
  // Talep etkisi 1-10; fiyat motoru yakınlıkla ağırlıklar.
  impact     Int               @default(5)
  /// Öneri → onay akışı: yalnızca APPROVED olaylar fiyata yansır.
  status     DemandEventStatus @default(APPROVED)
  category   String?
  rationale  String?
  source     String?
  proposedBy String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([locationId, startsAt])
  @@index([startsAt, endsAt])
  @@index([status, locationId])
}

enum DemandEventStatus {
  PROPOSED
  APPROVED
  REJECTED
  ROLLED_BACK
}

model Amenity {
  id         String     @id @default(cuid())
  name       String     @unique
  icon       String?
  properties Property[] @relation("PropertyAmenities")
}

/// Oda tipi (v3 P0-2, ADR 0010): "Standart Çift × 12". API'de `roomId` = oda tipi kimliği.
model RoomType {
  id               String            @id @default(cuid())
  propertyId       String
  property         Property          @relation(fields: [propertyId], references: [id])
  name             String
  description      String?
  /// Bir odada kalabilecek azami kişi.
  maxOccupancy     Int
  /// Bu tipten kaç oda satılabilir (günlük `InventoryDay.total` varsayılanı).
  units            Int               @default(1)
  bedType          String
  priceModifierMinor BigInt @default(0)
  available        Boolean           @default(true)
  inventory        InventoryDay[]
  ratePlans        RatePlan[]
  restrictions     Restriction[]
  externalBlocks   ExternalBlock[]
  bookings         Booking[]
  cartItems        CartItem[]
  priceAlerts      PriceAlert[]
  priceSuggestions PriceSuggestion[]
  accessibilityFeatures AccessibilityFeature[]

  @@index([propertyId])
  @@index([available])
}

/// Gecelik sayaçlı envanter: `sold + held <= total` (CHECK kısıtı migration'da).
model InventoryDay {
  id               String   @id @default(cuid())
  roomTypeId       String
  roomType         RoomType @relation(fields: [roomTypeId], references: [id])
  date             DateTime @db.Date
  total            Int
  sold             Int      @default(0)
  held             Int      @default(0)
  priceMinor       BigInt
  /// "Bu fiyat neden?": taban, faktör-başı katkılar ve tavan/taban kırpması.
  priceExplanation Json?
  /// Ev sahibi fiyatı elle/öneri kabulüyle sabitledi (P1-5): fiyat motoru bu geceyi ezmez.
  priceOverride    Boolean  @default(false)

  @@unique([roomTypeId, date])
  @@index([date])
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

/// Fiyat planı: aynı oda tipinin farklı koşullarla satışı (kahvaltılı, iade edilemez…).
model RatePlan {
  id                   String              @id @default(cuid())
  roomTypeId           String
  roomType             RoomType            @relation(fields: [roomTypeId], references: [id])
  code                 String
  name                 String
  mealPlan             MealPlan            @default(ROOM_ONLY)
  refundable           Boolean             @default(true)
  /// Planın kendi iptal politikası (yoksa mülkünki; iade edilemezse NON_REFUNDABLE).
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  /// Gece fiyatına baz puan farkı (−1000 = %10 indirim, +1200 = %12 fark).
  priceModifierBps     Int                 @default(0)
  isDefault            Boolean             @default(false)
  active               Boolean             @default(true)
  bookings             Booking[]
  createdAt            DateTime            @default(now())

  @@unique([roomTypeId, code])
  @@index([roomTypeId, active])
}

/// Gece bazlı satış kısıtı (LOS / CTA / CTD / stop-sell).
model Restriction {
  id                String   @id @default(cuid())
  roomTypeId        String
  roomType          RoomType @relation(fields: [roomTypeId], references: [id])
  date              DateTime @db.Date
  minStay           Int?
  maxStay           Int?
  closedToArrival   Boolean  @default(false)
  closedToDeparture Boolean  @default(false)
  stopSell          Boolean  @default(false)

  @@unique([roomTypeId, date])
}

/// Harici kanaldan (iCal) gelen dolu aralık: başka kanalda satılmış birimler (`sold`'a sayılır).
model ExternalBlock {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  source     String
  uid        String
  date       DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([roomTypeId, source, uid, date])
  @@index([roomTypeId, source])
}

model Booking {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id])
  propertyId             String
  property               Property          @relation(fields: [propertyId], references: [id])
  /// Oda tipi kimliği (geriye uyum için alan adı `roomId`).
  roomId                 String
  room                   RoomType          @relation(fields: [roomId], references: [id])
  ratePlanId             String?
  ratePlan               RatePlan?         @relation(fields: [ratePlanId], references: [id])
  /// Rezerve edilen oda adedi (sayaçlardan bu kadar düşülür).
  units                  Int               @default(1)
  checkIn                DateTime          @db.Date
  checkOut               DateTime          @db.Date
  guestCount             Int
  totalPriceMinor        BigInt
  currency               String            @default("TRY")
  status                 BookingStatus     @default(PENDING)
  /// HELD durumundaki geçici tutma süresi; dolunca expire-holds işi envanteri iade eder.
  holdExpiresAt          DateTime?
  /// İyimser eşzamanlılık sürümü: her durum geçişinde +1 (koşullu güncelleme).
  version                Int               @default(0)
  /// computeTotal() kırılımının anlık görüntüsü (geceler, ara toplam, vergiler, toplam; minor-unit).
  priceBreakdown         Json?
  quoteId                String?
  /// Rezervasyon anındaki iptal politikası (sonradan değişse de bu geçerlidir).
  policySnapshot         Json?
  /// Rezervasyon anındaki kur tablosu (görüntüleme ve misafir para biriminde tahsilat).
  fxSnapshot             Json?
  /// Kullanılan kalıcı kur tablosu (P0-5); statik yedek tablo kullanıldıysa null.
  fxSnapshotId           String?
  fxRate                 FxRate?           @relation(fields: [fxSnapshotId], references: [id], onDelete: SetNull)
  ledgerEntries          LedgerEntry[]
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  expiredAt              DateTime?
  idempotencyKey         String?
  /// v4#9: Idempotency-Key'in bağlı olduğu istek gövdesinin sha256 özeti (farklıysa 409).
  idempotencyRequestHash String?
  /// P1-1: sepetten doğan rezervasyon (grup kimliği = sepet); tek rezervasyonda null.
  cartId                 String?
  cart                   Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  payment                Payment?
  reviews                Review[]
  transfers              BookingTransfer[]
  payouts                Payout[]
  /// P1-8: bu rezervasyonda kullanılan (limitli) promosyonlar.
  promotionRedemptions   PromotionRedemption[]
  invoice                Invoice?
  messageThread          MessageThread?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([status, checkIn])
  @@index([status, holdExpiresAt])
  @@index([cartId])
}

/// Kalıcı kur tablosu (P0-5): her `fx-refresh` çalışması bir satır. Oranlar "1 TRY = x".
/// Teklif `fxSnapshotId` ile bir satıra bağlanır; kur değişse de teklif aynı tutarla tahsil edilir.
model FxRate {
  id        String    @id @default(cuid())
  base      String    @default("TRY")
  /// { "USD": 0.0243, "EUR": 0.0221, ... }
  rates     Json
  /// tcmb | ecb | static
  source    String
  /// Kaynağın yayım tarihi
  asOf      DateTime  @db.Date
  /// Ağ yoktu → statik yedek tablo yazıldı
  stale     Boolean   @default(false)
  fetchedAt DateTime  @default(now())
  bookings  Booking[]

  @@index([fetchedAt])
}

/// PENDING → HELD → CONFIRMED → COMPLETED | CANCELLED | EXPIRED (src/lib/booking/state-machine.ts)
enum BookingStatus {
  PENDING
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  /// Ödemenin sahibi = rezervasyonun güncel sahibi (devirde alıcıya geçer).
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amountMinor    BigInt
  currency       String        @default("TRY")
  provider       String
  /// PSP tarafındaki ödeme kimliği (mock: pi_mock_…, stripe: pi_…).
  providerRef    String?       @unique
  status         PaymentStatus @default(PENDING)
  refundedAmountMinor BigInt @default(0)
  failureCode    String?
  authorizedAt   DateTime?
  paidAt         DateTime?
  refundedAt     DateTime?
  /// P1-1: sepetin tek PSP tahsilatından bu rezervasyona düşen pay (providerRef sepet ödemesinde).
  cartPaymentId  String?
  cartPayment    CartPayment?  @relation(fields: [cartPaymentId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider, status])
}

/// PSP webhook olayları — olay kimliği benzersiz: replay ikinci kez etki etmez.
model PaymentEvent {
  id          String   @id
  type        String
  providerRef String?
  receivedAt  DateTime @default(now())

  @@index([providerRef])
  /// P0-5: saklama bakımının parti silme taraması
  @@index([receivedAt])
}

enum LedgerKind {
  CHARGE
  REFUND
  TRANSFER_PAYMENT
  TRANSFER_PAYOUT
}

/// Para hareketleri defteri (escrow/devir izlenebilirliği).
model LedgerEntry {
  id        String     @id @default(cuid())
  bookingId String
  booking   Booking    @relation(fields: [bookingId], references: [id])
  userId    String
  kind      LedgerKind
  amountMinor BigInt
  currency  String
  reference String?
  createdAt DateTime   @default(now())

  @@index([bookingId])
  @@index([userId])
}

enum CancellationPolicyKind {
  NON_REFUNDABLE
  FLEXIBLE
  MODERATE
  STRICT
}

/// Sürümlü iptal politikası; kurallar: { tiers: [{ hoursBefore, refundPercent }], graceHours? }.
model CancellationPolicy {
  id         String                 @id @default(cuid())
  kind       CancellationPolicyKind
  version    Int                    @default(1)
  rules      Json
  createdAt  DateTime               @default(now())
  properties Property[]
  ratePlans  RatePlan[]

  @@unique([kind, version])
}

/// Bildirim kutusu (SMTP yoksa dev mailbox). dedupeKey: aynı olay iki kez → tek e-posta.
model Notification {
  id        String    @id @default(cuid())
  dedupeKey String    @unique
  channel   String    @default("email")
  userId    String?
  to        String
  subject   String
  text      String
  html      String
  status    String    @default("PENDING")
  transport String    @default("mailbox")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  /// Tahsil edildi (capture)
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

model Review {
  id                String                 @id @default(cuid())
  bookingId         String                 @unique
  booking           Booking                @relation(fields: [bookingId], references: [id])
  userId            String
  user              User                   @relation(fields: [userId], references: [id])
  propertyId        String
  property          Property               @relation(fields: [propertyId], references: [id])
  rating            Int
  comment           String?
  /// Ev sahibinin herkese açık yanıtı.
  hostReply         String?
  hostRepliedAt     DateTime?
  /// P1-7 alt puanlar (1–5, isteğe bağlı).
  cleanliness       Int?
  location          Int?
  staff             Int?
  value             Int?
  /// P1-7 moderasyon: yalnızca PUBLISHED yorumlar gösterilir ve puana katılır.
  moderationStatus  ReviewModerationStatus @default(PUBLISHED)
  /// Deterministik filtrenin/şikâyetlerin gerekçe kodları.
  moderationReasons Json                   @default("[]")
  reportCount       Int                    @default(0)
  reports           ReviewReport[]
  createdAt         DateTime               @default(now())

  @@index([propertyId, moderationStatus])
  @@index([propertyId])
  @@index([userId])
  @@index([propertyId, rating])
}

enum ReviewModerationStatus {
  PUBLISHED
  PENDING_REVIEW
  HIDDEN
  REMOVED
}

/// P1-7: kullanıcı şikâyeti; kullanıcı başına yorum başına tek.
model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  note       String?
  createdAt  DateTime @default(now())

  @@unique([reviewId, reporterId])
}

enum LicenseStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// P1-6: rezervasyona bağlı misafir–ev sahibi yazışması.
model MessageThread {
  id        String    @id @default(cuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Gövde yalnızca maskelenmiş haliyle saklanır (iletişim bilgisi platform dışına taşınmaz).
model Message {
  id          String        @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id])
  senderRole  String
  body        String
  maskedKinds String[]      @default([])
  /// Ev sahibinin onayladığı yapay zekâ taslağından mı gönderildi.
  fromAiDraft Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([threadId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  /// Azami deneme aşıldı; admin panelinden yeniden kuyruğa alınabilir.
  DEAD
}

model OutboxMessage {
  id             String       @id @default(cuid())
  eventType      String
  aggregateId    String
  aggregateType  String
  payload        Json
  correlationId  String?
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAfter DateTime     @default(now())
  /// PROCESSING kiralamasının bitişi; dolarsa mesaj başka bir işçi tarafından yeniden alınır.
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?

  @@index([status, availableAfter])
  @@index([status, lockedUntil])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  /// P0-5: saklama bakımının parti silme taraması
  @@index([status, processedAt])
}

model PriceHistory {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  month           DateTime @db.Date
  avgNightlyPriceMinor BigInt
  demandIndex     Float    @default(50)
  createdAt       DateTime @default(now())

  @@unique([propertyId, month])
  @@index([propertyId, month])
}

/// Fiyat alarmı (P1-4): kullanıcı bir konaklamayı izler; günlük iş fiyatı gözlemler ve
/// son PRICE_OMNIBUS_DAYS günün en düşüğünün altına inerse e-posta gönderir (outbox).
model PriceAlert {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomTypeId     String
  roomType       RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  checkIn        DateTime  @db.Date
  checkOut       DateTime  @db.Date
  guests         Int       @default(1)
  currency       String
  /// Son gözlenen konaklama toplamı (minor unit).
  lastTotalMinor Int
  /// Günlük gözlemler `[{ on: "YYYY-MM-DD", total: <minor> }]` (Omnibus referansı için).
  observations   Json      @default("[]")
  active         Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, roomTypeId, checkIn, checkOut, guests])
  @@index([active, checkIn])
}

/// LISTED → CAPTURE_PENDING → COMPLETED | FAILED (v4#1: sahiplik yalnızca capture sonrası geçer)
enum TransferStatus {
  LISTED
  CLAIMED
  CAPTURE_PENDING
  COMPLETED
  CANCELLED
  FAILED
}

model BookingTransfer {
  id              String         @id @default(cuid())
  bookingId       String
  booking         Booking        @relation(fields: [bookingId], references: [id])
  sellerId        String
  seller          User           @relation("transferSeller", fields: [sellerId], references: [id])
  status          TransferStatus @default(LISTED)
  askPriceMinor   BigInt
  currency        String         @default("TRY")
  /// İmzalı claim linkinin SHA-256 özeti — token'ın kendisi saklanmaz.
  tokenHash       String         @unique
  expiresAt       DateTime
  listedAt        DateTime       @default(now())
  claimedById     String?
  claimedBy       User?          @relation("transferBuyer", fields: [claimedById], references: [id])
  claimedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  /// v4#1: capture/commit başarısız → FAILED; sahiplik değişmez, yetkilendirme iptal/iade edilir.
  failedAt        DateTime?
  failureCode     String?
  buyerPaymentRef String?

  @@index([status, bookingId])
  @@index([status, expiresAt])
  @@index([sellerId])
  @@index([claimedById])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

/// Devir sonrası satıcıya yapılacak ödeme (#4). Talep anında PENDING açılır; mock payout işi
/// PAID'e çeker (`po_mock_…` referansı). Defterde karşılığı TRANSFER_PAYOUT satırıdır.
model Payout {
  id         String       @id @default(cuid())
  userId     String
  bookingId  String
  booking    Booking      @relation(fields: [bookingId], references: [id])
  transferId String       @unique
  amountMinor BigInt
  currency   String
  status     PayoutStatus @default(PENDING)
  reference  String?
  attempts   Int          @default(0)
  createdAt  DateTime     @default(now())
  paidAt     DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

/// Mock e-Arşiv fatura kaydı (DEMO — mali değeri yoktur). Rezervasyon başına bir fatura.
model Invoice {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  number    String   @unique
  amountMinor BigInt
  taxAmountMinor BigInt
  currency  String
  buyerName String
  issuedAt  DateTime @default(now())
}

/// Yönetici eylemleri denetim kaydı (değiştirilemez; yalnızca ekleme).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  /// P0-5: saklama bakımının parti silme taraması
  @@index([createdAt])
}

/// Ödeme öncesi kural tabanlı risk değerlendirmesi (P1-10); admin inceleme kuyruğu.
model FraudCheck {
  id         String    @id @default(cuid())
  bookingId  String
  userId     String
  score      Int
  decision   String
  reasons    Json
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([decision, createdAt])
  @@index([bookingId])
}

/// Kanal (ARI) mesaj sırası: oda tipi başına son uygulanan sıra numarası (P1-9).
model ChannelSequence {
  roomId       String   @id
  lastSequence Int
  lastKey      String?
  updatedAt    DateTime @updatedAt
}

/// iCal dışa aktarım tokenının sürümü (v3#21): sürüm artırılınca eski akış URL'leri geçersizleşir.
model ChannelFeed {
  roomTypeId   String   @id
  tokenVersion Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Harici kanal iCal aboneliği (v3#21): worker `ICAL_POLL_MINUTES` aralığıyla koşullu GET yapar.
model IcalSubscription {
  id           String    @id @default(cuid())
  roomTypeId   String
  source       String    @db.VarChar(40)
  url          String    @db.VarChar(2048)
  etag         String?   @db.VarChar(512)
  lastModified String?   @db.VarChar(128)
  lastPolledAt DateTime?
  lastStatus   String?   @db.VarChar(32)
  lastError    String?   @db.VarChar(500)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([roomTypeId, source])
  @@index([active, lastPolledAt])
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Tek kullanımlık e-posta doğrulama / şifre sıfırlama token'ı — yalnızca SHA-256 özeti saklanır.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
  /// P0-5: saklama bakımının parti silme taraması
  @@index([expiresAt])
}

/// Passkey (WebAuthn) kimlik bilgisi; `id` = base64url credential ID.
model WebAuthnCredential {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  publicKey  Bytes
  counter    Int       @default(0)
  transports String[]  @default([])
  name       String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// P1-3: deney maruziyeti (exposure). Özne başına deney başına ilk atama tek satır; aynı
/// işlemde outbox'a `experiment.exposure` olayı yazılır. Dönüşüm, maruziyetten sonra
/// oluşturulan iptal edilmemiş rezervasyonlarla hesaplanır (bkz. ADR 0014).
model ExperimentExposure {
  id        String   @id @default(cuid())
  flagKey   String
  variant   String
  /// Kullanıcı id'si veya (analitik onayı varsa) anonim oturum id'si.
  subjectId String
  userId    String?
  createdAt DateTime @default(now())

  @@unique([flagKey, subjectId])
  @@index([flagKey, variant])
}

/// Ajan checkout oturumu (P1-11, ACP benzeri): ajan teklifi alır, kullanıcı onaylar,
/// tamamlama aynı quote → hold → ödeme saga yolundan geçer. Sahibi dışında görünmez.
model CheckoutSession {
  id             String   @id @default(cuid())
  userId         String
  /// Oluşturma isteğinin `Idempotency-Key` başlığı (kullanıcı başına tekil).
  idempotencyKey String   @db.VarChar(128)
  /// Aynı anahtarla farklı gövde gönderilirse 409 için istek özeti (sha256).
  requestHash    String   @db.VarChar(64)
  /// ready_for_payment | in_progress | completed | canceled
  status         String   @db.VarChar(32)
  propertyId     String
  roomId         String
  checkIn        String   @db.VarChar(10)
  checkOut       String   @db.VarChar(10)
  guests         Int
  quoteId        String?
  currency       String   @db.VarChar(3)
  /// Teklif kırılımı (minor-unit): ara toplam, ücret, vergi, toplam.
  totals         Json
  bookingId      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

enum PriceSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Gelir paneli fiyat önerisi (P1-5): deterministik motor [taban, tavan] içinde önerir,
/// LLM yalnızca Türkçe açıklama cümlesini yazar. Kabul → InventoryDay fiyatı + priceOverride;
/// ret → hiçbir fiyat değişmez.
model PriceSuggestion {
  id             String                @id @default(cuid())
  roomTypeId     String
  roomType       RoomType              @relation(fields: [roomTypeId], references: [id])
  date           DateTime              @db.Date
  currency       String
  currentMinor   Int
  suggestedMinor Int
  floorMinor     Int
  ceilingMinor   Int
  /// Faktör katkıları: [{ factor, multiplier, amountMinor }] (+ kırpma satırı).
  contributions  Json
  explanation    String
  llmMode        String
  status         PriceSuggestionStatus @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime              @default(now())

  @@index([roomTypeId, status, date])
}

// ─── P0-3: çift girişli defter (ledger v2, ADR 0020) ──────────────────────────

/// Hesap planı türleri (src/lib/ledger/accounts.ts). Borç/alacak doğal yönü türden gelir.
enum LedgerAccountKind {
  GUEST_RECEIVABLE
  PSP_CLEARING
  HOST_PAYABLE
  PLATFORM_REVENUE
  TAX_PAYABLE
  GUEST_CREDIT
  ESCROW
  /// P1-4: ev sahibi rezervi (`host_reserve:<userId>`) — RESERVE_RELEASE_DAYS sonra host_payable'a.
  HOST_RESERVE
  /// fix-sweep-2: platform zararı (gider, borç-doğal) — kaybedilen itirazda ev sahibinden
  /// tahsil edilemeyen kısım (`platform_loss`).
  PLATFORM_LOSS
}

enum JournalSide {
  DEBIT
  CREDIT
}

/// Defter hesabı. Sistem hesapları tekildir (`code` = tür adı); kişi alt hesapları
/// `ownerId` taşır (`host_payable:<userId>`, `guest_credit:<userId>`).
model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique
  kind      LedgerAccountKind
  ownerId   String?
  name      String
  createdAt DateTime          @default(now())
  lines     JournalLine[]

  @@index([kind, ownerId])
}

/// Dengeli jurnal kaydı (Σborç = Σalacak, para birimi başına). Yalnızca eklenir.
model JournalEntry {
  id             String        @id
  /// Aynı iş olayı ikinci kez yazılmaz (örn. `booking-captured:<paymentId>`).
  idempotencyKey String        @unique
  /// Şablon adı (BOOKING_CAPTURED, REFUND_ISSUED, …).
  kind           String
  /// Satırların kanonik özeti — aynı anahtarla farklı içerik 409 döner.
  linesHash      String
  bookingId      String?
  paymentId      String?
  transferId     String?
  occurredAt     DateTime
  memo           String?
  createdAt      DateTime      @default(now())
  lines          JournalLine[]

  @@index([bookingId])
  @@index([paymentId])
  @@index([transferId])
  @@index([occurredAt])
}

model JournalLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id])
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  side        JournalSide
  /// Pozitif minor-unit tutar (TRY: kuruş); yön `side` ile verilir.
  amountMinor BigInt
  currency    String

  @@index([entryId])
  @@index([accountId, currency])
}

/// P1-10 görsel zekâ (ADR 0022): host'un yüklediği fotoğraf. Bayt normalize WebP'dir
/// (EXIF/GPS silinmiş, uzun kenar sınırlı). Skorlar 0..1; `pHash` 64-bit DCT perceptual hash
/// (16 hex). `embedding` CLIP ViT-B/32 (L2-normalize, 512-d); model/bayrak yoksa null.
model PropertyPhoto {
  id                String                      @id @default(cuid())
  propertyId        String
  property          Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById      String?
  contentType       String
  data              Bytes
  width             Int
  height            Int
  byteSize          Int
  /// Laplacian varyansı (ham) ve 0..1 normalize netlik skoru.
  blurVariance      Float?
  blurScore         Float?
  /// Histogram tabanlı pozlama skoru (0..1; orta ton + kırpılmamış uçlar = yüksek).
  exposureScore     Float?
  qualityScore      Float?
  pHash             String?                     @db.Char(16)
  /// Yüklemede bulunan en yakın perceptual duplikat (Hamming ≤ eşik); yoksa null.
  duplicateOfId     String?
  duplicateOf       PropertyPhoto?              @relation("PhotoDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        PropertyPhoto[]             @relation("PhotoDuplicates")
  /// P1-13(e): bu fotoğrafı kanıt gösteren erişilebilirlik özellikleri.
  accessibilityEvidence AccessibilityFeature[]
  duplicateDistance Int?
  embedding         Unsupported("vector(512)")?
  embeddingModel    String?
  createdAt         DateTime                    @default(now())

  @@index([propertyId, createdAt])
  @@index([pHash])
  @@index([duplicateOfId])
}

/// P1-13a: 7565 s. Kanun kapsamında yetkili makam (Bakanlık) kaldırma talebi. İlan alındığı
/// anda pasife alınır; `slaDueAt` (alınma + TAKEDOWN_SLA_HOURS) geçtiğinde ilan hâlâ yayında
/// ya da talep işlenmemişse SLA aşımı (metrik + alarm). İlişki alanı yok (yalnız ekleme).
model TakedownRequest {
  id            String         @id @default(cuid())
  source        TakedownSource
  /// Resmî yazı / evrak numarası.
  referenceNo   String?
  propertyId    String
  reason        String
  receivedAt    DateTime
  slaDueAt      DateTime
  status        TakedownStatus @default(RECEIVED)
  actionedAt    DateTime?
  slaCheckedAt  DateTime?
  slaBreachedAt DateTime?
  createdById   String
  resolvedAt    DateTime?
  resolvedById  String?
  resolution    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([propertyId, status])
  @@index([status, slaDueAt])
}

enum TakedownSource {
  MINISTRY_7565
  COURT_ORDER
  OTHER_AUTHORITY
}

enum TakedownStatus {
  /// Alındı; ilan henüz pasife alınamadı.
  RECEIVED
  /// İlan pasif (kaldırma uygulandı).
  ACTIONED
  /// Yönetici kapattı (kaldırma sürer ya da talep geri çekildi → ilan yeniden açılabilir).
  CLOSED
}

/// P1-13b: DSA (AB 2022/2065) md. 16 bildirim-ve-eylem. Herkese açık formdan gelir;
/// karar md. 17 gerekçeli karar bildirimiyle (statement of reasons) e-postalanır.
model Notice {
  id                 String          @id @default(cuid())
  propertyId         String?
  contentUrl         String
  category           NoticeCategory
  explanation        String
  reporterName       String?
  reporterEmail      String
  goodFaith          Boolean
  locale             String          @default("tr")
  status             NoticeStatus    @default(RECEIVED)
  decision           NoticeDecision?
  decisionGround     NoticeGround?
  legalReference     String?
  statementOfReasons String?
  automated          Boolean         @default(false)
  decidedAt          DateTime?
  decidedById        String?
  createdAt          DateTime        @default(now())

  @@index([status, createdAt])
  @@index([propertyId])
}

enum NoticeCategory {
  ILLEGAL_LISTING
  UNLICENSED
  FRAUD_SCAM
  IP_INFRINGEMENT
  DISCRIMINATION
  UNSAFE
  OTHER
}

enum NoticeStatus {
  RECEIVED
  DECIDED
}

enum NoticeDecision {
  /// İçerik kaldırıldı / ilan pasife alındı.
  REMOVED
  /// İşlem yapılmadı.
  NO_ACTION
}

enum NoticeGround {
  /// Hukuka aykırı içerik (md. 17(3)(d)).
  ILLEGAL_CONTENT
  /// Kullanım koşullarına aykırılık (md. 17(3)(e)).
  TERMS_OF_SERVICE
}

/// P1-13(e): erişilebilirlik özelliği kodları (ADA 36.302(e) açıklama gerekliliği, EAA).
enum AccessibilityCode {
  STEP_FREE_ENTRANCE
  STEP_FREE_PATH_TO_ROOM
  ROLL_IN_SHOWER
  GRAB_BARS
  SHOWER_CHAIR
  ACCESSIBLE_PARKING
  WIDE_DOORWAY
  ELEVATOR
  VISUAL_ALARM
  LOWERED_BED
  ACCESSIBLE_TOILET
}

/// P1-13(e): ilan (roomTypeId null) veya oda tipi düzeyinde erişilebilirlik özelliği.
/// Host beyan eder + kanıt fotoğrafı bağlar; yalnız admin doğrulaması (`verifiedAt`) sonrası
/// herkese "doğrulanmış" olarak gösterilir ve arama filtresine girer. Kanıt/ölçü değişince
/// doğrulama düşer. (propertyId, roomTypeId NULL, code) tekilliği migration'da kısmi indeksle.
model AccessibilityFeature {
  id              String            @id @default(cuid())
  propertyId      String
  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId      String?
  roomType        RoomType?         @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  code            AccessibilityCode
  /// WIDE_DOORWAY için net kapı genişliği (cm); diğer kodlarda null.
  widthCm         Int?
  note            String?
  evidencePhotoId String?
  evidencePhoto   PropertyPhoto?    @relation(fields: [evidencePhotoId], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  verifiedById    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([propertyId, roomTypeId, code])
  @@index([code, verifiedAt])
  @@index([roomTypeId])
  @@index([evidencePhotoId])
}

/// P1-3 esnek tarih fiyat takvimi: tesis × gece için en ucuz 1 gecelik fiyatın materyalize
/// görünümü (türetilmiş veri; `src/lib/pricing/price-calendar.ts` yeniden hesaplar). Fiyat
/// teklif motorunun (`priceStay`) 1 gece + `PRICE_CALENDAR_GUESTS` kişi sonucudur. Satılabilir
/// oda yoksa `availableRoomTypes = 0` ve fiyat alanları NULL. İlişki alanı yok (Property'ye
/// dokunulmadı); ilan pasife alınınca satırlar hesaplamada silinir.
model MinPriceByDate {
  propertyId         String
  date               DateTime @db.Date
  /// Vergiler hariç gecelik fiyat (oda farkı + plan farkı dahil), minor-unit.
  minNightlyMinor    BigInt?
  /// Vergiler/ücretler dahil 1 gecelik toplam ("all-in" gösterim), minor-unit.
  minTotalMinor      BigInt?
  currency           String
  /// O gece satılabilir (boş birimi olan, satışı kapalı olmayan) oda tipi sayısı.
  availableRoomTypes Int
  /// En ucuz seçeneğin oda tipi ve fiyat planı.
  roomTypeId         String?
  ratePlanId         String?
  /// En ucuz seçeneğin varış kısıtları (UI'da "en az N gece" / "girişe kapalı").
  minStay            Int?
  closedToArrival    Boolean  @default(false)
  /// Hesaplamada kullanılan kişi sayısı (kişi başı vergiler için).
  guests             Int
  updatedAt          DateTime @updatedAt

  @@id([propertyId, date])
  @@index([date])
}

// --- P1-6 KYC ve güven-emniyet -------------------------------------------------------
// İlişki alanı YOK (User/Booking/Message modellerine dokunulmaz); kimlikler düz string + index.

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  REQUIRES_INPUT
  FAILED
}

/// Kimlik doğrulama oturumu (P1-6). Belge görüntüsü / kimlik numarası SAKLANMAZ: yalnızca
/// sağlayıcı oturum kimliği, durum ve (varsa) sağlayıcının kısa hata kodu tutulur.
model IdentityVerification {
  id          String                     @id @default(cuid())
  userId      String
  /// mock | stripe
  provider    String
  status      IdentityVerificationStatus @default(PENDING)
  providerRef String
  /// Sağlayıcının makine kodu (ör. document_unverified_other); kişisel veri içermez.
  lastError   String?
  verifiedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
}

/// Mesaj dolandırıcılık taraması sonucu (P1-6). Engellenen mesajda `messageId` boştur
/// (mesaj kaydedilmez). Karar yalnızca kural skorundan; `llmSignal` ek bilgidir.
model MessageRiskFlag {
  id        String   @id @default(cuid())
  messageId String?  @unique
  bookingId String
  senderId  String
  /// NONE (yalnızca LLM sinyali) | WARN | HIGH
  level     String
  score     Int
  reasons   String[]
  llmSignal String?
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  /// P0-5: saklama bakımının parti silme taraması
  @@index([createdAt])
}

/// Parti riski değerlendirmesi (P1-6): rezervasyon başına tek satır, açıklanabilir gerekçe kodlarıyla.
model PartyRiskAssessment {
  id         String    @id @default(cuid())
  bookingId  String    @unique
  propertyId String
  hostId     String
  guestId    String
  score      Int
  reasons    String[]
  flagged    Boolean
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([hostId, flagged, createdAt])
}

// ───────────────────────── P1-1: çok odalı / grup sepeti ─────────────────────────

enum CartStatus {
  OPEN
  HELD
  CHECKED_OUT
  EXPIRED
  CANCELLED
}

/// Grup sepeti: N oda tipi × N doluluk; tutma tümü-ya-hiç (tek SERIALIZABLE işlem).
/// Kullanıcı başına en fazla bir aktif (OPEN/HELD) sepet — kısmi benzersiz indeks (migration).
model Cart {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             CartStatus   @default(OPEN)
  /// Tahsilat para birimi (ilk kalemin teklifinden; tüm kalemler bu birimde fiyatlanır).
  currency           String
  /// HELD iken tüm kalem rezervasyonlarının ortak tutma bitişi.
  holdExpiresAt      DateTime?
  /// Tutma isteğinin Idempotency-Key'i ve gövde özeti (farklı gövde → 409).
  holdIdempotencyKey String?
  holdRequestHash    String?
  /// İyimser eşzamanlılık sürümü (her durum geçişinde +1).
  version            Int          @default(0)
  checkedOutAt       DateTime?
  expiredAt          DateTime?
  cancelledAt        DateTime?
  items              CartItem[]
  bookings           Booking[]
  payment            CartPayment?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([userId, holdIdempotencyKey])
  @@index([userId, status])
  @@index([status, holdExpiresAt])
}

model CartItem {
  id                       String   @id @default(cuid())
  cartId                   String
  cart                     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  propertyId               String
  roomTypeId               String
  roomType                 RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlanId               String?
  checkIn                  DateTime @db.Date
  checkOut                 DateTime @db.Date
  adults                   Int
  children                 Int      @default(0)
  /// Oda adedi (sayaçtan bu kadar düşülür).
  quantity                 Int      @default(1)
  /// Teklif anlık görüntüsü: tahsilat (sepet) biriminde toplam + tesis biriminde toplam.
  quotedTotalMinor         BigInt
  quotedPropertyTotalMinor BigInt
  propertyCurrency         String
  quoteSnapshot            Json?
  fxSnapshotId             String?
  /// Son tutmada oluşan rezervasyon (yeniden tutmada güncellenir).
  bookingId                String?  @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([cartId])
}

/// Sepetin TEK PSP tahsilatı. Onayda her kalem rezervasyonuna bir `Payment` (payı) yazılır;
/// PSP gerçeği ve jurnaller rezervasyon/Payment düzeyinde kalır (mutabakat değişmeden çalışır).
/// P1-2 (bölünmüş ödeme) bu kaydın altına pay (share) tahsilatları ekler.
model CartPayment {
  id                  String        @id @default(cuid())
  cartId              String        @unique
  cart                Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId              String
  amountMinor         BigInt
  currency            String
  provider            String
  providerRef         String?       @unique
  status              PaymentStatus @default(PENDING)
  refundedAmountMinor BigInt        @default(0)
  failureCode         String?
  authorizedAt        DateTime?
  paidAt              DateTime?
  refundedAt          DateTime?
  payments            Payment[]
  /// P1-2: bölünmüş ödeme planları (en fazla biri aktif; kısmi benzersiz indeks).
  splitPlans          SplitPlan[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

/// P1-8: promosyon türü. Uygunluk koşulları tesisin yerel "bugün"üne göre değerlendirilir.
enum PromotionType {
  /// Varışa en az `minDaysBefore` gün kala yapılan rezervasyon.
  EARLY_BIRD
  /// Varışa en çok `maxDaysBefore` gün kala yapılan rezervasyon.
  LAST_MINUTE
  /// En az `minNights` gecelik konaklama.
  LONG_STAY
  /// Mobil kanaldan (mobil tarayıcı/uygulama) alınan teklif.
  MOBILE_RATE
  /// Kod ile; `usageLimit` checkout'ta atomik sayılır.
  COUPON
}

/// P1-8: promosyon kuralı. İndirim ya yüzde (`discountBps`) ya sabit tutardır (`discountMinor`,
/// `currency` biriminde, konaklama başına). Seçim: öncelik → en büyük indirim → id (deterministik).
model Promotion {
  id            String                @id @default(cuid())
  hostId        String
  host          User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  /// null → ev sahibinin tüm ilanları.
  propertyId    String?
  property      Property?             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  type          PromotionType
  discountBps   Int?
  discountMinor BigInt?
  currency      String?
  minDaysBefore Int?
  maxDaysBefore Int?
  minNights     Int?
  /// Büyük harfe normalize edilir; ev sahibi başına tekil.
  couponCode    String?
  usageLimit    Int?
  usageCount    Int                   @default(0)
  /// Rezervasyon (teklif) anı geçerlilik aralığı; null → sınırsız.
  startsAt      DateTime?
  endsAt        DateTime?
  priority      Int                   @default(0)
  stackable     Boolean               @default(false)
  /// Birleşebilir promosyonlarda aynı gruptan yalnız biri uygulanır.
  stackGroup    String?
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  redemptions   PromotionRedemption[]

  @@unique([hostId, couponCode])
  @@index([hostId, active])
  @@index([propertyId, active])
}

/// P1-8: limitli promosyonun bir rezervasyonda kullanımı. Tutma düşerse (süre dolumu/ödeme
/// hatası/onay öncesi iptal) satır silinir ve `usageCount` geri alınır.
model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountMinor BigInt
  currency    String
  createdAt   DateTime  @default(now())

  @@unique([promotionId, bookingId])
  @@index([bookingId])
}

/// P1-8 Omnibus: oda tipinin gece fiyatı değişim geçmişi. `InventoryDay.priceMinor` her
/// değiştiğinde (INSERT/UPDATE) veritabanı tetiği yazar → uygulama yazıcılarından bağımsız.
/// Aylık ortalamayı tutan `PriceHistory` bu iş için uygun değil (gece/an çözünürlüğü yok).
model InventoryPriceHistory {
  id          BigInt   @id @default(autoincrement())
  roomTypeId  String
  date        DateTime @db.Date
  priceMinor  BigInt
  effectiveAt DateTime @default(now())

  @@index([roomTypeId, date, effectiveAt])
  /// P0-5: saklama bakımının parti silme taraması
  @@index([effectiveAt])
}

/// P1-4 ev sahibi ödeme hesabı (ADR 0021). `kycStatus` payout sağlayıcısının bağlı hesap
/// durumudur (Stripe Connect); mock sağlayıcıda P1-6 IdentityVerification'dan türetilir.
/// İlişki alanı yok (User'a dokunulmadı); `userId` tekil.
model HostAccount {
  id                  String         @id @default(cuid())
  userId              String         @unique
  /// Ödeme sağlayıcısı: `mock` | `stripe` (Connect).
  provider            String
  /// Sağlayıcıdaki bağlı hesap kimliği (Stripe `acct_…`, mock `acct_mock_…`).
  connectedAccountRef String?        @unique
  kycStatus           HostKycStatus  @default(NOT_STARTED)
  /// Sağlayıcı ödemeye izin veriyor mu (KYC tamam + hesap etkin).
  payoutsEnabled      Boolean        @default(false)
  /// Yönetici durdurması: true iken bu kullanıcıya hiçbir payout açılmaz/gönderilmez.
  payoutsPaused       Boolean        @default(false)
  pausedReason        String?
  pausedAt            DateTime?
  pausedById          String?
  /// Rezerv oranı (bps); null → PAYOUT_RESERVE_BPS.
  reservePercentBps   Int?
  payoutSchedule      PayoutSchedule @default(DAILY)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

enum HostKycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum PayoutSchedule {
  DAILY
  WEEKLY
  MONTHLY
}

/// P1-4 ev sahibi payout'u: serbest bırakılmış `host_payable:<userId>` bakiyesinden açılır;
/// PAID olduğunda aynı tx'te `payoutReleased` jurnali yazılır. Devir payout'ları eski
/// `Payout` tablosunda kalır (aynı motor öder).
model HostPayout {
  id          String       @id @default(cuid())
  userId      String
  amountMinor BigInt
  currency    String
  status      PayoutStatus @default(PENDING)
  provider    String
  reference   String?
  failureCode String?
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now())
  paidAt      DateTime?
  failedAt    DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ───────────── P1-2 bölünmüş ödeme (split payment) ─────────────

enum PaymentShareStatus {
  INVITED
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  VOIDED
  REFUNDED
  EXPIRED
}

enum SplitFallbackMode {
  /// Süre sonunda ödenmemiş paylar organizatöre tek "yedek pay" olarak düşer.
  ORGANIZER_PAYS
  /// Süre sonunda tüm yetkilendirmeler void / tahsilatlar iade, tutmalar serbest.
  REFUND_ALL
}

enum SplitPlanStatus {
  COLLECTING
  FALLBACK
  SETTLED
  ABORTED
}

/// Sepetin bölünmüş ödeme planı: paylar ayrı PSP yetkilendirmesi; hepsi yetkilenince hepsi
/// tahsil edilir ve sepet tek işlemde onaylanır (CartPayment = plan toplamı, providerRef null).
model SplitPlan {
  id            String            @id @default(cuid())
  cartId        String
  cartPaymentId String
  cartPayment   CartPayment       @relation(fields: [cartPaymentId], references: [id], onDelete: Cascade)
  organizerId   String
  fallbackMode  SplitFallbackMode
  status        SplitPlanStatus   @default(COLLECTING)
  /// Payların son ödeme anı (yedek aşamasında organizatörün son anı). Tutma bitişinden önce.
  deadlineAt    DateTime
  settledAt     DateTime?
  abortedAt     DateTime?
  abortReason   String?
  shares        PaymentShare[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([cartId])
  @@index([status, deadlineAt])
}

/// Bölünmüş ödemenin bir payı (katılımcı ya da organizatör). Davet linki HMAC imzalı ve
/// süreli; `inviteNonce` değişirse eski linkler geçersiz olur.
model PaymentShare {
  id                  String               @id @default(cuid())
  planId              String
  plan                SplitPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  cartPaymentId       String
  cartId              String
  position            Int
  isOrganizer         Boolean              @default(false)
  /// Süre sonunda ödenmemiş payları organizatöre toplayan yedek pay.
  isFallback          Boolean              @default(false)
  participantEmail    String?
  /// Payı ödeyen (ya da ödemesi beklenen organizatör) kullanıcı.
  payerUserId         String?
  amountMinor         BigInt
  currency            String
  status              PaymentShareStatus   @default(INVITED)
  provider            String?
  providerRef         String?              @unique
  failureCode         String?
  refundedAmountMinor BigInt               @default(0)
  inviteNonce         String
  authorizedAt        DateTime?
  capturedAt          DateTime?
  refundedAt          DateTime?
  refunds             PaymentShareRefund[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([planId, position])
  @@index([cartId])
  @@index([payerUserId])
}

/// Bölünmüş ödemeli sepette kalem iptali iadesinin paylara dağılımı (PSP iadesi pay başına).
model PaymentShareRefund {
  id          String       @id @default(cuid())
  shareId     String
  share       PaymentShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  bookingId   String
  amountMinor BigInt
  currency    String
  /// PENDING → PSP iadesi bekleniyor/yeniden denenecek; DONE → iade edildi.
  status      String       @default("PENDING")
  refundRef   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([shareId, bookingId])
  @@index([bookingId])
}

/// P1-5 hasar depozitosu ayarı: ilan geneli (roomTypeId=null) ya da oda tipine özel tutar
/// (oda tipi ilan genelini ezer). Para birimi ilanın para birimidir. İlişki alanı yok
/// (mevcut modellere dokunmamak için); sahiplik servis katmanında denetlenir.
model DamageDepositSetting {
  id          String   @id @default(cuid())
  propertyId  String
  roomTypeId  String?
  amountMinor BigInt
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, roomTypeId])
  @@index([propertyId])
}

enum DamageDepositStatus {
  /// Tutar belirlendi; ön provizyon anı (yerel giriş − DEPOSIT_PREAUTH_HOURS_BEFORE) bekleniyor.
  SCHEDULED
  AUTHORIZED
  CAPTURED_PARTIAL
  CAPTURED
  VOIDED
  /// Provizyon süresi (DEPOSIT_AUTH_VALID_DAYS) doldu; artık tahsil edilemez.
  EXPIRED
  /// PSP ön provizyonu reddetti / kaynak kart yeniden kullanılamıyor.
  FAILED
}

/// P1-5: rezervasyon tahsilatından AYRI PSP ön provizyonu (manuel capture). Capture tutarı
/// ön provizyonu aşamaz (DB CHECK + kod). Çıkış + DEPOSIT_HOLD_DAYS sonra talep yoksa void.
model DamageDeposit {
  id               String              @id @default(cuid())
  bookingId        String              @unique
  amountMinor      BigInt
  currency         String
  capturedMinor    BigInt              @default(0)
  status           DamageDepositStatus @default(SCHEDULED)
  provider         String
  /// PSP ön provizyon kimliği (mock: pi_mockhold_…, stripe: pi_…).
  providerRef      String?             @unique
  /// Kartı yeniden kullanılan asıl tahsilatın PSP kimliği.
  sourcePaymentRef String?
  failureCode      String?
  authorizeAfter   DateTime
  voidAfter        DateTime
  authorizedAt     DateTime?
  capturedAt       DateTime?
  voidedAt         DateTime?
  expiredAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, authorizeAfter])
  @@index([status, voidAfter])
}

enum ClaimType {
  /// Misafirin iade talebi (ilan tarif edildiği gibi değil vb.).
  GUEST_REFUND
  /// Ev sahibinin hasar talebi (depozitodan tahsil).
  HOST_DAMAGE
  /// PSP itirazı (Stripe `charge.dispute.*`); taraflar değil PSP açar.
  CHARGEBACK
}

enum ClaimStatus {
  /// Karşı taraf yanıt verdi; yönetici kararı bekleniyor.
  OPEN
  /// Karşı tarafın yanıtı bekleniyor (SLA: slaDueAt).
  AWAITING_RESPONSE
  /// SLA aşıldı ya da PSP itirazı: yönetici önceliği.
  ESCALATED
  RESOLVED_APPROVED
  RESOLVED_PARTIAL
  RESOLVED_REJECTED
  /// Açan geri çekti ya da itiraz kararsız kapandı.
  CLOSED
}

/// P1-5 çözüm merkezi talebi. Tutarlar minor-unit, rezervasyon para biriminde.
model Claim {
  id                   String          @id @default(cuid())
  bookingId            String
  type                 ClaimType
  /// Açan kullanıcı (CHARGEBACK'te null: PSP açar).
  openedById           String?
  /// Yanıt vermesi beklenen karşı taraf.
  respondentId         String?
  amountRequestedMinor BigInt
  currency             String
  description          String
  status               ClaimStatus     @default(AWAITING_RESPONSE)
  slaDueAt             DateTime?
  respondedAt          DateTime?
  escalatedAt          DateTime?
  /// Karar: onaylanan tutar, fiilen iade/tahsil edilen, tahsil edilemeyen (yalnız kayıt),
  /// platformun üstlendiği (ev sahibi bakiyesi yetmediğinde).
  awardedMinor         BigInt?
  settledMinor         BigInt?
  uncollectedMinor     BigInt?
  platformCoveredMinor BigInt?
  decisionNote         String?
  decidedById          String?
  decidedAt            DateTime?
  /// PSP itiraz kimliği (Stripe `dp_…`), durum ve gerekçe.
  externalRef          String?         @unique
  externalStatus       String?
  externalReason       String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  messages             ClaimMessage[]
  evidence             ClaimEvidence[]

  @@index([bookingId])
  @@index([status, slaDueAt])
  @@index([openedById])
  @@index([respondentId])
}

model ClaimMessage {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  authorId  String
  /// Yazanın rolü talepte: OPENER | RESPONDENT | ADMIN | SYSTEM.
  role      String
  body      String
  createdAt DateTime @default(now())

  @@index([claimId, createdAt])
}

/// Kanıt dosyası: görseller `sharp` ile yeniden kodlanır (tüm metadata/EXIF/GPS silinir),
/// PDF yalnız boyut + imza doğrulamasıyla saklanır. Yalnız taraflar ve yönetici okur.
model ClaimEvidence {
  id          String   @id @default(cuid())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploaderId  String
  contentType String
  byteSize    Int
  width       Int?
  height      Int?
  sha256      String
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([claimId, createdAt])
}

/// P2-1a: DSA md. 20 iç şikâyet (itiraz). Bildiren (REPORTER) ya da kararla etkilenen ev
/// sahibi (HOST) karar e-postasındaki imzalı bağlantıyla itiraz eder; karar başına rol
/// başına tek itiraz. UPHELD önceki kararı tersine çevirir (REMOVED → yeniden yayın serbest;
/// NO_ACTION → ilan kaldırılır). İlişki alanı yok (Notice modeline dokunulmadı).
model NoticeAppeal {
  id             String             @id @default(cuid())
  noticeId       String
  propertyId     String?
  appellantRole  NoticeAppealRole
  appellantEmail String
  reason         String
  locale         String             @default("tr")
  status         NoticeAppealStatus @default(PENDING)
  response       String?
  decisionGround NoticeGround?
  decidedAt      DateTime?
  decidedById    String?
  createdAt      DateTime           @default(now())

  @@unique([noticeId, appellantRole])
  @@index([status, createdAt])
  @@index([propertyId])
}

enum NoticeAppealRole {
  REPORTER
  HOST
}

enum NoticeAppealStatus {
  PENDING
  /// İtiraz kabul edildi: önceki karar tersine çevrildi.
  UPHELD
  /// İtiraz reddedildi: karar geçerli.
  REJECTED
}

// ---------------------------------------------------------------------------
// P1-7 sadakat & cüzdan (ADR 0020 §Kredi). Mevcut modellere ilişki/kolon eklenmez (FK yok);
// para hareketi jurnalde (`guest_credit:<userId>`), lot'lar yalnız harcama/son kullanma izi.
// Değişmez: guest_credit bakiyesi = Σ lot.remainingMinor + Σ RESERVED harcama (kullanıcı+para birimi).
// ---------------------------------------------------------------------------

/// Kullanıcının sadakat seviyesi: tamamlanan konaklama sayısından (outbox tüketicisi) türetilir.
model LoyaltyAccount {
  userId         String   @id
  completedStays Int      @default(0)
  /// 0..3 (LOYALTY_TIER_THRESHOLDS indeksi).
  tier           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum LoyaltyCashbackStatus {
  PENDING
  ISSUED
  SKIPPED
}

/// Tamamlanan konaklamanın cashback'i: iade/talep penceresi (dueAt) sonrası krediye çevrilir.
model LoyaltyCashback {
  id          String                @id @default(cuid())
  bookingId   String                @unique
  userId      String
  currency    String
  tier        Int
  bps         Int
  amountMinor BigInt?
  status      LoyaltyCashbackStatus @default(PENDING)
  dueAt       DateTime
  issuedAt    DateTime?
  creditId    String?
  reason      String?
  createdAt   DateTime              @default(now())

  @@index([status, dueAt])
  @@index([userId])
}

enum WalletCreditSource {
  CASHBACK
  REFUND
}

/// Kredi lot'u: harcama FIFO (son kullanma tarihi en yakın önce); süre dolunca kalan ters jurnalle düşer.
model WalletCredit {
  id             String                  @id @default(cuid())
  userId         String
  currency       String
  source         WalletCreditSource
  /// İdempotent kaynak anahtarı (`cashback:<bookingId>`, `refund:<spendId>:<allocationId>`).
  sourceRef      String                  @unique
  amountMinor    BigInt
  remainingMinor BigInt
  /// Süre dolumuyla düşülen toplam (jurnal anahtarı bundan türer).
  expiredMinor   BigInt                  @default(0)
  expiresAt      DateTime
  bookingId      String?
  createdAt      DateTime                @default(now())
  allocations    CreditSpendAllocation[]

  @@index([userId, currency, expiresAt])
  @@index([expiresAt])
}

enum CreditSpendStatus {
  RESERVED
  SPENT
  RELEASED
}

/// Rezervasyon ödemesinde kullanılan kredi: RESERVED (kart öncesi) → SPENT (onay) | RELEASED.
model CreditSpend {
  id            String                  @id @default(cuid())
  userId        String
  bookingId     String
  currency      String
  amountMinor   BigInt
  /// Harcamanın vergi payı (creditSpent jurnalinde tax_payable'a yazılan).
  taxMinor      BigInt                  @default(0)
  refundedMinor BigInt                  @default(0)
  status        CreditSpendStatus       @default(RESERVED)
  releaseReason String?
  createdAt     DateTime                @default(now())
  settledAt     DateTime?
  releasedAt    DateTime?
  allocations   CreditSpendAllocation[]

  @@index([bookingId])
  @@index([userId, status])
}

/// Harcamanın lot dağılımı (iade aynı lot'un son kullanma tarihiyle yeni lot açar).
model CreditSpendAllocation {
  id            String       @id @default(cuid())
  spendId       String
  spend         CreditSpend  @relation(fields: [spendId], references: [id], onDelete: Cascade)
  creditId      String
  credit        WalletCredit @relation(fields: [creditId], references: [id])
  amountMinor   BigInt
  refundedMinor BigInt       @default(0)

  @@unique([spendId, creditId])
  @@index([creditId])
}

/// fix-sweep-2: bölünmüş ödemeli (P1-2) rezervasyonda çözüm merkezi misafir iadesinin
/// (GUEST_REFUND) tahsil edilmiş paylara dağılımı. Kapasite, PSP çağrısından ÖNCE ayrılır
/// (PaymentShare.refundedAmountMinor artar) → eşzamanlı kalem iptali aynı payı aşamaz.
/// PENDING → PSP iadesi bekleniyor (karar yeniden denenirse aynı satır kullanılır); DONE →
/// iade edildi. İlişki alanı yok (mevcut modellere dokunmamak için).
model ClaimShareRefund {
  id          String   @id @default(cuid())
  claimId     String
  shareId     String
  bookingId   String
  amountMinor BigInt
  currency    String
  status      String   @default("PENDING")
  refundRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([claimId, shareId])
  @@index([bookingId])
}

/// fix-sweep-2: kullanıcının PSP müşteri kaydı (Stripe Customer `cus_…`). Hasar depozitosu
/// gereken rezervasyonda ödeme bu müşteriye bağlanır ve kart `setup_future_usage=off_session`
/// ile kaydedilir → depozito ön provizyonu off-session alınabilir. Kart verisi tutulmaz.
model PaymentCustomer {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  customerRef String   @unique
  createdAt   DateTime @default(now())

  @@unique([userId, provider])
}
