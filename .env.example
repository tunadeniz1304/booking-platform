# booking-platform — ortam değişkenleri (yalnızca ADLAR; değerleri siz verin).
# `cp .env.example .env` → yerel geliştirme için gerekli alanları doldurun.
# docker compose demo'sunda sırlar boş bırakılabilir: `secrets-init` rastgele üretir.
# Aşağıdaki sayısal ayarların yorumlarında varsayılan değerler yazar.

# --- Uygulama ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Virgülle ayrık izinli origin'ler (CSRF Origin kontrolü)
APP_ORIGINS=
LOG_LEVEL=info
# Logları stderr'e yaz (stdio protokollü süreçler için; `npm run mcp:server` kendisi ayarlar)
# LOG_TO_STDERR=false
# production'da Secure çerez; yalnızca http demo için false
COOKIE_SECURE=
# 0 = doğrudan internete açık (X-Forwarded-For'a güvenme), 1 = bir ters proxy arkasında
TRUSTED_PROXY_HOPS=0
# hops=0 iken önde x-real-ip'yi ezen tek bir ters vekil varsa true (yoksa parmak izi kovası)
# TRUST_REAL_IP_HEADER=false
# Demo modu: true → demo seed + /dev/mailbox + varsayılan MockPsp + "DEMO" rozeti.
# false → demo seed reddedilir, mailbox 404, ödeme sağlayıcısı açıkça seçilmeli.
# Boşsa: production dışı ortamlar demo, production demo değil.
DEMO_MODE=true

# --- Veritabanı (PostgreSQL + pgvector) ----------------------------------------
DATABASE_URL=postgresql://booking:CHANGE_ME@localhost:5432/booking?connection_limit=10&pool_timeout=15
POSTGRES_USER=booking
POSTGRES_PASSWORD=
POSTGRES_DB=booking
# Prisma sorgu profil'leyicisi (varsayılan kapalı)
ENABLE_QUERY_STATS=false

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- Kimlik doğrulama / sırlar (her biri en az 32 karakter rastgele) -------------------
JWT_SECRET=
INTERNAL_API_SECRET=
TRANSFER_SIGNING_SECRET=
# iCal akış tokenlarını imzalar
CHANNEL_FEED_SECRET=
PSP_WEBHOOK_SECRET=
# /api/metrics Bearer token'ı
METRICS_TOKEN=
# ACCESS_TOKEN_TTL_SECONDS=300
# REFRESH_TOKEN_TTL_SECONDS=604800
# Hesap kilidi: art arda N başarısız giriş → M dakika kilit
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
# Şifre sıfırlama bağlantısı ömrü (dk) ve e-posta doğrulama bağlantısı ömrü (saat)
# AUTH_RESET_TOKEN_TTL_MINUTES=30
# AUTH_VERIFY_TOKEN_TTL_HOURS=24
# Passkey (WebAuthn): tarayıcıdaki alan adı ve origin
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=booking-platform
# WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# --- LLM (yoksa DEMO modu; ilk bulunan kazanır) --------------------------------------
# Anahtar: LLM_API_KEY → DEEPSEEK_API_KEY → EVREN_API_KEY → OPENAI_API_KEY
LLM_API_KEY=
# Base URL: LLM_BASE_URL → DEEPSEEK_BASE_URL → EVREN_BASE_URL → OPENAI_BASE_URL
# (varsayılan https://evren-llmapi.ssyz.org.tr/v1)
LLM_BASE_URL=
# Model: LLM_MODEL → DEEPSEEK_MODEL (varsayılan deepseek-v4-flash)
LLM_MODEL=
# auto | live | demo
LLM_MODE=auto
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800
# LLM_MAX_TOOL_STEPS=5
# Kullanıcı başına günlük token bütçesi (0 = sınırsız); aşımda demo + reason "budget"
# LLM_DAILY_TOKEN_BUDGET_PER_USER=50000
# Yalnızca geliştirmede, redakte hâliyle (debug seviyesi)
LLM_LOG_PROMPTS=false
# Opsiyonel gerçek embedding modeli (boşsa ağsız hash-embedding)
EMBEDDING_MODEL=

# --- Ödeme -----------------------------------------------------------------
# mock | stripe. Boşsa yalnızca demo modunda mock; stripe seçilip anahtar yoksa açılış hatası.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# --- E-posta (boşsa dev mailbox'a yazılır) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Servisler ----------------------------------------------------------------
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
# gRPC TLS (PEM dosya yolları). CERT+KEY → TLS; CA da verilirse istemci sertifikası zorunlu.
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
# İstemci tarafı mTLS (opsiyonel)
GRPC_TLS_CLIENT_CERT=
GRPC_TLS_CLIENT_KEY=
# MCP stdio sunucusu (npm run mcp:server): kimlik bu ortam değişkeninden gelir — araç
# argümanlarında kimlik bilgisi YOKTUR. Boşsa create_hold UNAUTHORIZED döner.
MCP_ACCESS_TOKEN=
# Boşsa izleme (tracing) no-op
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=booking-web
# İşçi süreci Prometheus metrik portu
WORKER_METRICS_PORT=9464
# Statik kur tablosunu ezmek için JSON (ör. {"USD":0.029,"EUR":0.027}) — ağ yokken yedek
FX_RATES_JSON=
# Kalıcı kur (P0-5): sırayla denenecek kaynaklar; "none" → ağ yok, yalnızca statik tablo
# FX_SOURCES=tcmb,ecb
# FX_TCMB_URL=https://www.tcmb.gov.tr/kurlar/today.xml
# FX_ECB_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
# FX_FETCH_TIMEOUT_MS=5000
# Günlük fx-refresh işi (cron, UTC)
# FX_REFRESH_CRON=45 12 * * *
# FX_STALE_HOURS=72
# Bu kadar günden eski ve hiçbir rezervasyonun bağlı olmadığı kur satırları silinir (en yenisi kalır)
# FX_RETENTION_DAYS=90
# FX_CACHE_SECONDS=60
# Tesis para birimi dışında tahsilat yapılabilecek birimler (ör. USD,EUR); boş → yalnızca tesis
# FX_CHARGE_CURRENCIES=
# Opsiyonel gözlemlenebilirlik profili host portları (başka projelerle çakışırsa değiştirin)
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# --- İş kuralları (yorumdaki değerler varsayılandır) --------------------------------------
# BOOKING_HOLD_TTL_MINUTES=15
# MAX_STAY_NIGHTS=30
# QUOTE_TTL_MINUTES=15
# Vergi/ücret kuralları (P0-4): boşsa data/tax-rules.json (TR KDV %10 dahil, konaklama
# vergisi %2; 1 Mayıs–31 Aralık 2026 %1). JSON dizi ya da {"rules":[...]} kabul edilir.
# TAX_RULES_JSON=
# Platform hizmet bedeli (baz puan, 0 = yok)
# SERVICE_FEE_BPS=0
# Geçmiş envanter günlerinin saklama süresi (gün); giriş/çıkış saati tesis bazında (Property)
# INVENTORY_RETENTION_DAYS=400
# PRICE_FLOOR_MULTIPLIER=0.6
# PRICE_CEILING_MULTIPLIER=2.0
# EVENT_FACTOR_PER_POINT=0.05
# YIELD_HOLD_MAX_SHARE=0.2
# Fiyat içgörüsü: split conformal hata oranı (0.1 → %90 aralık), asgari kalibrasyon, pencere (gün)
# PRICE_INSIGHT_ALPHA=0.1
# PRICE_INSIGHT_MIN_CALIBRATION=20
# PRICE_INSIGHT_WINDOW_DAYS=90
# Omnibus "önceki fiyat" = son N günün en düşüğü; günlük fiyat alarmı işi (cron, UTC); kullanıcı başına azami alarm
# PRICE_OMNIBUS_DAYS=30
# PRICE_ALERT_CRON=15 6 * * *
# PRICE_ALERT_MAX_PER_USER=20
# FEATURE_TRANSFER=true
# TRANSFER_MAX_ASK_RATIO=1.0
# TRANSFER_MIN_HOURS_BEFORE_CHECKIN=48
# TRANSFER_LINK_TTL_HOURS=168
# FRAUD_REVIEW_THRESHOLD=40
# FRAUD_BLOCK_THRESHOLD=80
# ROUTING_MAX_CITIES=12
# ROUTING_FLIGHT_COST_PER_KM=0.09
# ROUTING_FLIGHT_COST_BASE=40

# --- Rate-limit ve canlı akış (pencere başına istek) ------------------------------------
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT_MAX=100
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_SEARCH_MAX=60
# RATE_LIMIT_BOOKING_MAX=30
# RATE_LIMIT_AI_MAX=20
# Hesap (e-posta) başına giriş denemesi / pencere — IP'den bağımsız
# RATE_LIMIT_LOGIN_PER_ACCOUNT_MAX=10
# LIVE_MAX_RANGE_DAYS=60
# LIVE_MAX_CONNECTIONS_PER_IP=3
# LIVE_POLL_INTERVAL_MS=3000
# LIVE_VIEW_DEDUPE_SECONDS=600
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_LEASE_SECONDS=60
# OUTBOX_BACKOFF_BASE_MS=1000

# --- Geliştirici betikleri ---------------------------------------------------
# npm run docs:screenshots hedefi (varsayılan http://localhost:3000)
# SCREENSHOT_BASE_URL=http://localhost:3000
