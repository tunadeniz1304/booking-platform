{
  "name": "booking-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Booking.com ölçeğinde, yüksek eşzamanlılık kaldırabilen konaklama ve rezervasyon platformu",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:unit",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "grpc:server": "tsx --conditions=react-server services/grpc/main.ts",
    "embeddings:backfill": "tsx scripts/backfill-embeddings.ts",
    "llm:smoke": "tsx --conditions=react-server scripts/llm-smoke.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.7.15",
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pino": "^10.3.1",
    "prisma": "^5.17.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.16.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "fast-check": "^3.23.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.39",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.6",
    "testcontainers": "^12.1.0",
    "typescript": "^5.5.3",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
