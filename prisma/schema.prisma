generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  payments      Payment[]
  properties    Property[]
  listedTransfers  BookingTransfer[] @relation("transferSeller")
  claimedTransfers BookingTransfer[] @relation("transferBuyer")
}

enum UserRole {
  USER
  HOST
  ADMIN
}

model Property {
  id            String     @id @default(cuid())
  hostId        String
  host          User       @relation(fields: [hostId], references: [id])
  title         String
  description   String
  propertyType  PropertyType
  locationId    String
  location      Location   @relation(fields: [locationId], references: [id])
  amenities     Amenity[]  @relation("PropertyAmenities")
  rooms         Room[]
  bookings      Booking[]
  reviews       Review[]
  favorites     Favorite[]
  basePrice     Decimal    @db.Decimal(10, 2)
  currency      String     @default("TRY")
  ratingAvg     Float      @default(0)
  ratingCount   Int        @default(0)
  isActive      Boolean     @default(true)
  images        String[]    @default([])
  embedding     Unsupported("vector(128)")?
  priceHistory  PriceHistory[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([locationId, isActive])
  @@index([hostId])
  @@index([propertyType, isActive])
  @@index([ratingAvg])
}

enum PropertyType {
  HOTEL
  APARTMENT
  VILLA
  HOSTEL
  BED_AND_BREAKFAST
}

model Location {
  id         String        @id @default(cuid())
  city       String
  country    String
  latitude   Float?
  longitude  Float?
  properties Property[]
  demandEvents DemandEvent[]

  @@unique([city, country])
  @@index([city])
  @@index([country])
}

model DemandEvent {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  title      String
  startsAt   DateTime @db.Date
  endsAt     DateTime @db.Date
  // Talep etkisi 1-10; fiyat motoru yakınlıkla ağırlıklar.
  impact     Int      @default(5)
  createdAt  DateTime @default(now())

  @@index([locationId, startsAt])
  @@index([startsAt, endsAt])
}

model Amenity {
  id         String     @id @default(cuid())
  name       String     @unique
  icon       String?
  properties Property[] @relation("PropertyAmenities")
}

model Room {
  id            String         @id @default(cuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id])
  name          String
  description   String?
  capacity      Int
  bedType       String
  priceModifier Decimal        @default(0) @db.Decimal(10, 2)
  available     Boolean        @default(true)
  availabilities Availability[]
  bookings      Booking[]

  @@index([propertyId])
  @@index([available])
}

model Availability {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  date        DateTime @db.Date
  isAvailable Boolean  @default(true)
  price       Decimal  @db.Decimal(10, 2)
  lockedBy    String?

  @@unique([roomId, date])
  @@index([date])
  @@index([roomId, isAvailable, date])
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id])
  roomId     String
  room       Room          @relation(fields: [roomId], references: [id])
  checkIn    DateTime      @db.Date
  checkOut   DateTime      @db.Date
  guestCount Int
  totalPrice Decimal       @db.Decimal(10, 2)
  currency   String        @default("TRY")
  status     BookingStatus @default(PENDING)
  idempotencyKey String?
  payment      Payment?
  reviews      Review[]
  transfers    BookingTransfer[]
  createdAt    DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([status, checkIn])
  @@unique([userId, idempotencyKey])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id])
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("TRY")
  provider  String
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([status])
  @@index([provider, status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
  @@index([propertyId, rating])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model OutboxMessage {
  id             String       @id @default(cuid())
  eventType      String
  aggregateId    String
  aggregateType  String
  payload        Json
  correlationId  String?
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAfter DateTime     @default(now())
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?

  @@index([status, availableAfter])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
}

model PriceHistory {
  id              String        @id @default(cuid())
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id])
  month           DateTime      @db.Date
  avgNightlyPrice Decimal       @db.Decimal(10, 2)
  demandIndex     Float         @default(50)
  createdAt       DateTime      @default(now())

  @@unique([propertyId, month])
  @@index([propertyId, month])
}

enum TransferStatus {
  LISTED
  CLAIMED
  COMPLETED
  CANCELLED
}

model BookingTransfer {
  id            String         @id @default(cuid())
  bookingId     String
  booking       Booking        @relation(fields: [bookingId], references: [id])
  sellerId      String
  seller        User           @relation("transferSeller", fields: [sellerId], references: [id])
  status        TransferStatus @default(LISTED)
  askPrice      Decimal        @db.Decimal(10, 2)
  currency      String         @default("TRY")
  // HMAC imzalı devir jetonu — delegasyonu doğrulanabilir kılar (denetlenebilir).
  transferToken String         @unique
  listedAt      DateTime       @default(now())
  claimedById   String?
  claimedBy     User?          @relation("transferBuyer", fields: [claimedById], references: [id])
  claimedAt     DateTime?
  completedAt   DateTime?

  @@index([status, bookingId])
  @@index([sellerId])
  @@index([claimedById])
}