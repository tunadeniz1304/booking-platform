generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatarUrl           String?
  role                UserRole             @default(USER)
  /// Oturum dönemi: artırıldığında bu kullanıcının TÜM erişim/yenileme token'ları geçersizleşir
  /// (hesap silme, rol değişimi, şifre sıfırlama — v3#5).
  tokenVersion        Int                  @default(0)
  emailVerifiedAt     DateTime?
  /// Art arda başarısız giriş sayısı ve kilit bitişi (AUTH_LOCKOUT_*).
  failedLoginCount    Int                  @default(0)
  lockedUntil         DateTime?
  deletedAt           DateTime?
  /// Arayüz/e-posta dili (tr|en); kayıt ve girişte NEXT_LOCALE çerezinden güncellenir (P1-12).
  locale              String               @default("tr")
  authTokens          AuthToken[]
  webAuthnCredentials WebAuthnCredential[]
  sessions            UserSession[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookings            Booking[]
  reviews             Review[]
  favorites           Favorite[]
  payments            Payment[]
  properties          Property[]
  listedTransfers     BookingTransfer[]    @relation("transferSeller")
  claimedTransfers    BookingTransfer[]    @relation("transferBuyer")
  priceAlerts         PriceAlert[]
  messages            Message[]
  reviewReports       ReviewReport[]
}

/// Oturum (yenileme token ailesi) kaydı — P0-4 oturum listesi + uzaktan çıkış.
/// `id` = yenileme ailesi kimliği (erişim token'ında `sid`). Token sırları Redis'te kalır;
/// burada yalnızca görüntüleme/yeni cihaz tespiti için meta veri tutulur.
model UserSession {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// İmzalı `did` çerezinden cihaz kimliği (yeni cihaz bildirimi için).
  deviceId   String?
  userAgent  String?
  /// Kaba IP ipucu (IPv4 /24, IPv6 /64) — tam IP saklanmaz.
  ipHint     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([userId, deviceId])
}

enum UserRole {
  USER
  HOST
  ADMIN
}

model Property {
  id                   String                      @id @default(cuid())
  hostId               String
  host                 User                        @relation(fields: [hostId], references: [id])
  title                String
  description          String
  propertyType         PropertyType
  locationId           String
  location             Location                    @relation(fields: [locationId], references: [id])
  amenities            Amenity[]                   @relation("PropertyAmenities")
  /// Oda tipleri (v3 P0-2): satış birimi oda tipidir; `units` adet oda.
  rooms                RoomType[]
  /// IANA saat dilimi; gece, iade penceresi, iCal ve checkout sonrası tamamlama bu dilimde (ADR 0011).
  timeZone             String                      @default("Europe/Istanbul")
  /// Yerel giriş/çıkış saati (SS:DD).
  checkInTime          String                      @default("15:00")
  checkOutTime         String                      @default("11:00")
  bookings             Booking[]
  reviews              Review[]
  favorites            Favorite[]
  basePrice            Decimal                     @db.Decimal(10, 2)
  currency             String                      @default("TRY")
  ratingAvg            Float                       @default(0)
  ratingCount          Int                         @default(0)
  isActive             Boolean                     @default(true)
  images               String[]                    @default([])
  embedding            Unsupported("vector(128)")?
  /// P1-1 hibrit arama: başlık + açıklamadan üretilen tsvector (GENERATED ALWAYS, `simple` +
  /// `turkish` yapılandırması, GIN indeksli). Yalnızca SQL'de okunur; migration'da tanımlı.
  searchVector         Unsupported("tsvector")?
  priceHistory         PriceHistory[]
  /// P1-10: yüklenen fotoğraflar (kalite skoru, pHash, CLIP embedding).
  photos               PropertyPhoto[]
  /// İptal politikası (yoksa varsayılan MODERATE); rezervasyonda snapshot'ı alınır.
  /// Turizm İşletme Belgesi / 7464 izin belgesi no (ör. 34-12345); boşsa ilan yayınlanmaz.
  licenseNumber        String?
  /// P1-10: kayıt no doğrulama durumu (TR 7565 / AB 2024/1028 mock kayıtları). Yayın için VERIFIED şart.
  licenseStatus        LicenseStatus               @default(PENDING)
  licenseCheckedAt     DateTime?
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy?         @relation(fields: [cancellationPolicyId], references: [id])
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([locationId, isActive])
  @@index([hostId])
  @@index([propertyType, isActive])
  @@index([ratingAvg])
}

enum PropertyType {
  HOTEL
  APARTMENT
  VILLA
  HOSTEL
  BED_AND_BREAKFAST
}

model Location {
  id           String        @id @default(cuid())
  city         String
  country      String
  latitude     Float?
  longitude    Float?
  properties   Property[]
  demandEvents DemandEvent[]

  @@unique([city, country])
  @@index([city])
  @@index([country])
}

model DemandEvent {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id])
  title      String
  startsAt   DateTime          @db.Date
  endsAt     DateTime          @db.Date
  // Talep etkisi 1-10; fiyat motoru yakınlıkla ağırlıklar.
  impact     Int               @default(5)
  /// Öneri → onay akışı: yalnızca APPROVED olaylar fiyata yansır.
  status     DemandEventStatus @default(APPROVED)
  category   String?
  rationale  String?
  source     String?
  proposedBy String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([locationId, startsAt])
  @@index([startsAt, endsAt])
  @@index([status, locationId])
}

enum DemandEventStatus {
  PROPOSED
  APPROVED
  REJECTED
  ROLLED_BACK
}

model Amenity {
  id         String     @id @default(cuid())
  name       String     @unique
  icon       String?
  properties Property[] @relation("PropertyAmenities")
}

/// Oda tipi (v3 P0-2, ADR 0010): "Standart Çift × 12". API'de `roomId` = oda tipi kimliği.
model RoomType {
  id               String            @id @default(cuid())
  propertyId       String
  property         Property          @relation(fields: [propertyId], references: [id])
  name             String
  description      String?
  /// Bir odada kalabilecek azami kişi.
  maxOccupancy     Int
  /// Bu tipten kaç oda satılabilir (günlük `InventoryDay.total` varsayılanı).
  units            Int               @default(1)
  bedType          String
  priceModifier    Decimal           @default(0) @db.Decimal(10, 2)
  available        Boolean           @default(true)
  inventory        InventoryDay[]
  ratePlans        RatePlan[]
  restrictions     Restriction[]
  externalBlocks   ExternalBlock[]
  bookings         Booking[]
  priceAlerts      PriceAlert[]
  priceSuggestions PriceSuggestion[]

  @@index([propertyId])
  @@index([available])
}

/// Gecelik sayaçlı envanter: `sold + held <= total` (CHECK kısıtı migration'da).
model InventoryDay {
  id               String   @id @default(cuid())
  roomTypeId       String
  roomType         RoomType @relation(fields: [roomTypeId], references: [id])
  date             DateTime @db.Date
  total            Int
  sold             Int      @default(0)
  held             Int      @default(0)
  price            Decimal  @db.Decimal(10, 2)
  /// "Bu fiyat neden?": taban, faktör-başı katkılar ve tavan/taban kırpması.
  priceExplanation Json?
  /// Ev sahibi fiyatı elle/öneri kabulüyle sabitledi (P1-5): fiyat motoru bu geceyi ezmez.
  priceOverride    Boolean  @default(false)

  @@unique([roomTypeId, date])
  @@index([date])
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

/// Fiyat planı: aynı oda tipinin farklı koşullarla satışı (kahvaltılı, iade edilemez…).
model RatePlan {
  id                   String              @id @default(cuid())
  roomTypeId           String
  roomType             RoomType            @relation(fields: [roomTypeId], references: [id])
  code                 String
  name                 String
  mealPlan             MealPlan            @default(ROOM_ONLY)
  refundable           Boolean             @default(true)
  /// Planın kendi iptal politikası (yoksa mülkünki; iade edilemezse NON_REFUNDABLE).
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  /// Gece fiyatına baz puan farkı (−1000 = %10 indirim, +1200 = %12 fark).
  priceModifierBps     Int                 @default(0)
  isDefault            Boolean             @default(false)
  active               Boolean             @default(true)
  bookings             Booking[]
  createdAt            DateTime            @default(now())

  @@unique([roomTypeId, code])
  @@index([roomTypeId, active])
}

/// Gece bazlı satış kısıtı (LOS / CTA / CTD / stop-sell).
model Restriction {
  id                String   @id @default(cuid())
  roomTypeId        String
  roomType          RoomType @relation(fields: [roomTypeId], references: [id])
  date              DateTime @db.Date
  minStay           Int?
  maxStay           Int?
  closedToArrival   Boolean  @default(false)
  closedToDeparture Boolean  @default(false)
  stopSell          Boolean  @default(false)

  @@unique([roomTypeId, date])
}

/// Harici kanaldan (iCal) gelen dolu aralık: başka kanalda satılmış birimler (`sold`'a sayılır).
model ExternalBlock {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  source     String
  uid        String
  date       DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([roomTypeId, source, uid, date])
  @@index([roomTypeId, source])
}

model Booking {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id])
  propertyId             String
  property               Property          @relation(fields: [propertyId], references: [id])
  /// Oda tipi kimliği (geriye uyum için alan adı `roomId`).
  roomId                 String
  room                   RoomType          @relation(fields: [roomId], references: [id])
  ratePlanId             String?
  ratePlan               RatePlan?         @relation(fields: [ratePlanId], references: [id])
  /// Rezerve edilen oda adedi (sayaçlardan bu kadar düşülür).
  units                  Int               @default(1)
  checkIn                DateTime          @db.Date
  checkOut               DateTime          @db.Date
  guestCount             Int
  totalPrice             Decimal           @db.Decimal(10, 2)
  currency               String            @default("TRY")
  status                 BookingStatus     @default(PENDING)
  /// HELD durumundaki geçici tutma süresi; dolunca expire-holds işi envanteri iade eder.
  holdExpiresAt          DateTime?
  /// İyimser eşzamanlılık sürümü: her durum geçişinde +1 (koşullu güncelleme).
  version                Int               @default(0)
  /// computeTotal() kırılımının anlık görüntüsü (geceler, ara toplam, vergiler, toplam; minor-unit).
  priceBreakdown         Json?
  quoteId                String?
  /// Rezervasyon anındaki iptal politikası (sonradan değişse de bu geçerlidir).
  policySnapshot         Json?
  /// Rezervasyon anındaki kur tablosu (görüntüleme ve misafir para biriminde tahsilat).
  fxSnapshot             Json?
  /// Kullanılan kalıcı kur tablosu (P0-5); statik yedek tablo kullanıldıysa null.
  fxSnapshotId           String?
  fxRate                 FxRate?           @relation(fields: [fxSnapshotId], references: [id], onDelete: SetNull)
  ledgerEntries          LedgerEntry[]
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  expiredAt              DateTime?
  idempotencyKey         String?
  /// v4#9: Idempotency-Key'in bağlı olduğu istek gövdesinin sha256 özeti (farklıysa 409).
  idempotencyRequestHash String?
  payment                Payment?
  reviews                Review[]
  transfers              BookingTransfer[]
  payouts                Payout[]
  invoice                Invoice?
  messageThread          MessageThread?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([status, checkIn])
  @@index([status, holdExpiresAt])
}

/// Kalıcı kur tablosu (P0-5): her `fx-refresh` çalışması bir satır. Oranlar "1 TRY = x".
/// Teklif `fxSnapshotId` ile bir satıra bağlanır; kur değişse de teklif aynı tutarla tahsil edilir.
model FxRate {
  id        String    @id @default(cuid())
  base      String    @default("TRY")
  /// { "USD": 0.0243, "EUR": 0.0221, ... }
  rates     Json
  /// tcmb | ecb | static
  source    String
  /// Kaynağın yayım tarihi
  asOf      DateTime  @db.Date
  /// Ağ yoktu → statik yedek tablo yazıldı
  stale     Boolean   @default(false)
  fetchedAt DateTime  @default(now())
  bookings  Booking[]

  @@index([fetchedAt])
}

/// PENDING → HELD → CONFIRMED → COMPLETED | CANCELLED | EXPIRED (src/lib/booking/state-machine.ts)
enum BookingStatus {
  PENDING
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  /// Ödemenin sahibi = rezervasyonun güncel sahibi (devirde alıcıya geçer).
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("TRY")
  provider       String
  /// PSP tarafındaki ödeme kimliği (mock: pi_mock_…, stripe: pi_…).
  providerRef    String?       @unique
  status         PaymentStatus @default(PENDING)
  refundedAmount Decimal       @default(0) @db.Decimal(10, 2)
  failureCode    String?
  authorizedAt   DateTime?
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider, status])
}

/// PSP webhook olayları — olay kimliği benzersiz: replay ikinci kez etki etmez.
model PaymentEvent {
  id          String   @id
  type        String
  providerRef String?
  receivedAt  DateTime @default(now())

  @@index([providerRef])
}

enum LedgerKind {
  CHARGE
  REFUND
  TRANSFER_PAYMENT
  TRANSFER_PAYOUT
}

/// Para hareketleri defteri (escrow/devir izlenebilirliği).
model LedgerEntry {
  id        String     @id @default(cuid())
  bookingId String
  booking   Booking    @relation(fields: [bookingId], references: [id])
  userId    String
  kind      LedgerKind
  amount    Decimal    @db.Decimal(10, 2)
  currency  String
  reference String?
  createdAt DateTime   @default(now())

  @@index([bookingId])
  @@index([userId])
}

enum CancellationPolicyKind {
  NON_REFUNDABLE
  FLEXIBLE
  MODERATE
  STRICT
}

/// Sürümlü iptal politikası; kurallar: { tiers: [{ hoursBefore, refundPercent }], graceHours? }.
model CancellationPolicy {
  id         String                 @id @default(cuid())
  kind       CancellationPolicyKind
  version    Int                    @default(1)
  rules      Json
  createdAt  DateTime               @default(now())
  properties Property[]
  ratePlans  RatePlan[]

  @@unique([kind, version])
}

/// Bildirim kutusu (SMTP yoksa dev mailbox). dedupeKey: aynı olay iki kez → tek e-posta.
model Notification {
  id        String    @id @default(cuid())
  dedupeKey String    @unique
  channel   String    @default("email")
  userId    String?
  to        String
  subject   String
  text      String
  html      String
  status    String    @default("PENDING")
  transport String    @default("mailbox")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  /// Tahsil edildi (capture)
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

model Review {
  id                String                 @id @default(cuid())
  bookingId         String                 @unique
  booking           Booking                @relation(fields: [bookingId], references: [id])
  userId            String
  user              User                   @relation(fields: [userId], references: [id])
  propertyId        String
  property          Property               @relation(fields: [propertyId], references: [id])
  rating            Int
  comment           String?
  /// Ev sahibinin herkese açık yanıtı.
  hostReply         String?
  hostRepliedAt     DateTime?
  /// P1-7 alt puanlar (1–5, isteğe bağlı).
  cleanliness       Int?
  location          Int?
  staff             Int?
  value             Int?
  /// P1-7 moderasyon: yalnızca PUBLISHED yorumlar gösterilir ve puana katılır.
  moderationStatus  ReviewModerationStatus @default(PUBLISHED)
  /// Deterministik filtrenin/şikâyetlerin gerekçe kodları.
  moderationReasons Json                   @default("[]")
  reportCount       Int                    @default(0)
  reports           ReviewReport[]
  createdAt         DateTime               @default(now())

  @@index([propertyId, moderationStatus])
  @@index([propertyId])
  @@index([userId])
  @@index([propertyId, rating])
}

enum ReviewModerationStatus {
  PUBLISHED
  PENDING_REVIEW
  HIDDEN
  REMOVED
}

/// P1-7: kullanıcı şikâyeti; kullanıcı başına yorum başına tek.
model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  reason     String
  note       String?
  createdAt  DateTime @default(now())

  @@unique([reviewId, reporterId])
}

enum LicenseStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// P1-6: rezervasyona bağlı misafir–ev sahibi yazışması.
model MessageThread {
  id        String    @id @default(cuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Gövde yalnızca maskelenmiş haliyle saklanır (iletişim bilgisi platform dışına taşınmaz).
model Message {
  id          String        @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id])
  senderRole  String
  body        String
  maskedKinds String[]      @default([])
  /// Ev sahibinin onayladığı yapay zekâ taslağından mı gönderildi.
  fromAiDraft Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([threadId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  /// Azami deneme aşıldı; admin panelinden yeniden kuyruğa alınabilir.
  DEAD
}

model OutboxMessage {
  id             String       @id @default(cuid())
  eventType      String
  aggregateId    String
  aggregateType  String
  payload        Json
  correlationId  String?
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAfter DateTime     @default(now())
  /// PROCESSING kiralamasının bitişi; dolarsa mesaj başka bir işçi tarafından yeniden alınır.
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?

  @@index([status, availableAfter])
  @@index([status, lockedUntil])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
}

model PriceHistory {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  month           DateTime @db.Date
  avgNightlyPrice Decimal  @db.Decimal(10, 2)
  demandIndex     Float    @default(50)
  createdAt       DateTime @default(now())

  @@unique([propertyId, month])
  @@index([propertyId, month])
}

/// Fiyat alarmı (P1-4): kullanıcı bir konaklamayı izler; günlük iş fiyatı gözlemler ve
/// son PRICE_OMNIBUS_DAYS günün en düşüğünün altına inerse e-posta gönderir (outbox).
model PriceAlert {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomTypeId     String
  roomType       RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  checkIn        DateTime  @db.Date
  checkOut       DateTime  @db.Date
  guests         Int       @default(1)
  currency       String
  /// Son gözlenen konaklama toplamı (minor unit).
  lastTotalMinor Int
  /// Günlük gözlemler `[{ on: "YYYY-MM-DD", total: <minor> }]` (Omnibus referansı için).
  observations   Json      @default("[]")
  active         Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, roomTypeId, checkIn, checkOut, guests])
  @@index([active, checkIn])
}

/// LISTED → CAPTURE_PENDING → COMPLETED | FAILED (v4#1: sahiplik yalnızca capture sonrası geçer)
enum TransferStatus {
  LISTED
  CLAIMED
  CAPTURE_PENDING
  COMPLETED
  CANCELLED
  FAILED
}

model BookingTransfer {
  id              String         @id @default(cuid())
  bookingId       String
  booking         Booking        @relation(fields: [bookingId], references: [id])
  sellerId        String
  seller          User           @relation("transferSeller", fields: [sellerId], references: [id])
  status          TransferStatus @default(LISTED)
  askPrice        Decimal        @db.Decimal(10, 2)
  currency        String         @default("TRY")
  /// İmzalı claim linkinin SHA-256 özeti — token'ın kendisi saklanmaz.
  tokenHash       String         @unique
  expiresAt       DateTime
  listedAt        DateTime       @default(now())
  claimedById     String?
  claimedBy       User?          @relation("transferBuyer", fields: [claimedById], references: [id])
  claimedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  /// v4#1: capture/commit başarısız → FAILED; sahiplik değişmez, yetkilendirme iptal/iade edilir.
  failedAt        DateTime?
  failureCode     String?
  buyerPaymentRef String?

  @@index([status, bookingId])
  @@index([status, expiresAt])
  @@index([sellerId])
  @@index([claimedById])
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

/// Devir sonrası satıcıya yapılacak ödeme (#4). Talep anında PENDING açılır; mock payout işi
/// PAID'e çeker (`po_mock_…` referansı). Defterde karşılığı TRANSFER_PAYOUT satırıdır.
model Payout {
  id         String       @id @default(cuid())
  userId     String
  bookingId  String
  booking    Booking      @relation(fields: [bookingId], references: [id])
  transferId String       @unique
  amount     Decimal      @db.Decimal(10, 2)
  currency   String
  status     PayoutStatus @default(PENDING)
  reference  String?
  attempts   Int          @default(0)
  createdAt  DateTime     @default(now())
  paidAt     DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

/// Mock e-Arşiv fatura kaydı (DEMO — mali değeri yoktur). Rezervasyon başına bir fatura.
model Invoice {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  number    String   @unique
  amount    Decimal  @db.Decimal(10, 2)
  taxAmount Decimal  @db.Decimal(10, 2)
  currency  String
  buyerName String
  issuedAt  DateTime @default(now())
}

/// Yönetici eylemleri denetim kaydı (değiştirilemez; yalnızca ekleme).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

/// Ödeme öncesi kural tabanlı risk değerlendirmesi (P1-10); admin inceleme kuyruğu.
model FraudCheck {
  id         String    @id @default(cuid())
  bookingId  String
  userId     String
  score      Int
  decision   String
  reasons    Json
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([decision, createdAt])
  @@index([bookingId])
}

/// Kanal (ARI) mesaj sırası: oda tipi başına son uygulanan sıra numarası (P1-9).
model ChannelSequence {
  roomId       String   @id
  lastSequence Int
  lastKey      String?
  updatedAt    DateTime @updatedAt
}

/// iCal dışa aktarım tokenının sürümü (v3#21): sürüm artırılınca eski akış URL'leri geçersizleşir.
model ChannelFeed {
  roomTypeId   String   @id
  tokenVersion Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Harici kanal iCal aboneliği (v3#21): worker `ICAL_POLL_MINUTES` aralığıyla koşullu GET yapar.
model IcalSubscription {
  id           String    @id @default(cuid())
  roomTypeId   String
  source       String    @db.VarChar(40)
  url          String    @db.VarChar(2048)
  etag         String?   @db.VarChar(512)
  lastModified String?   @db.VarChar(128)
  lastPolledAt DateTime?
  lastStatus   String?   @db.VarChar(32)
  lastError    String?   @db.VarChar(500)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([roomTypeId, source])
  @@index([active, lastPolledAt])
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Tek kullanımlık e-posta doğrulama / şifre sıfırlama token'ı — yalnızca SHA-256 özeti saklanır.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

/// Passkey (WebAuthn) kimlik bilgisi; `id` = base64url credential ID.
model WebAuthnCredential {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  publicKey  Bytes
  counter    Int       @default(0)
  transports String[]  @default([])
  name       String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// P1-3: deney maruziyeti (exposure). Özne başına deney başına ilk atama tek satır; aynı
/// işlemde outbox'a `experiment.exposure` olayı yazılır. Dönüşüm, maruziyetten sonra
/// oluşturulan iptal edilmemiş rezervasyonlarla hesaplanır (bkz. ADR 0014).
model ExperimentExposure {
  id        String   @id @default(cuid())
  flagKey   String
  variant   String
  /// Kullanıcı id'si veya (analitik onayı varsa) anonim oturum id'si.
  subjectId String
  userId    String?
  createdAt DateTime @default(now())

  @@unique([flagKey, subjectId])
  @@index([flagKey, variant])
}

/// Ajan checkout oturumu (P1-11, ACP benzeri): ajan teklifi alır, kullanıcı onaylar,
/// tamamlama aynı quote → hold → ödeme saga yolundan geçer. Sahibi dışında görünmez.
model CheckoutSession {
  id             String   @id @default(cuid())
  userId         String
  /// Oluşturma isteğinin `Idempotency-Key` başlığı (kullanıcı başına tekil).
  idempotencyKey String   @db.VarChar(128)
  /// Aynı anahtarla farklı gövde gönderilirse 409 için istek özeti (sha256).
  requestHash    String   @db.VarChar(64)
  /// ready_for_payment | in_progress | completed | canceled
  status         String   @db.VarChar(32)
  propertyId     String
  roomId         String
  checkIn        String   @db.VarChar(10)
  checkOut       String   @db.VarChar(10)
  guests         Int
  quoteId        String?
  currency       String   @db.VarChar(3)
  /// Teklif kırılımı (minor-unit): ara toplam, ücret, vergi, toplam.
  totals         Json
  bookingId      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

enum PriceSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Gelir paneli fiyat önerisi (P1-5): deterministik motor [taban, tavan] içinde önerir,
/// LLM yalnızca Türkçe açıklama cümlesini yazar. Kabul → InventoryDay fiyatı + priceOverride;
/// ret → hiçbir fiyat değişmez.
model PriceSuggestion {
  id             String                @id @default(cuid())
  roomTypeId     String
  roomType       RoomType              @relation(fields: [roomTypeId], references: [id])
  date           DateTime              @db.Date
  currency       String
  currentMinor   Int
  suggestedMinor Int
  floorMinor     Int
  ceilingMinor   Int
  /// Faktör katkıları: [{ factor, multiplier, amountMinor }] (+ kırpma satırı).
  contributions  Json
  explanation    String
  llmMode        String
  status         PriceSuggestionStatus @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime              @default(now())

  @@index([roomTypeId, status, date])
}

// ─── P0-3: çift girişli defter (ledger v2, ADR 0020) ──────────────────────────

/// Hesap planı türleri (src/lib/ledger/accounts.ts). Borç/alacak doğal yönü türden gelir.
enum LedgerAccountKind {
  GUEST_RECEIVABLE
  PSP_CLEARING
  HOST_PAYABLE
  PLATFORM_REVENUE
  TAX_PAYABLE
  GUEST_CREDIT
  ESCROW
}

enum JournalSide {
  DEBIT
  CREDIT
}

/// Defter hesabı. Sistem hesapları tekildir (`code` = tür adı); kişi alt hesapları
/// `ownerId` taşır (`host_payable:<userId>`, `guest_credit:<userId>`).
model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique
  kind      LedgerAccountKind
  ownerId   String?
  name      String
  createdAt DateTime          @default(now())
  lines     JournalLine[]

  @@index([kind, ownerId])
}

/// Dengeli jurnal kaydı (Σborç = Σalacak, para birimi başına). Yalnızca eklenir.
model JournalEntry {
  id             String        @id
  /// Aynı iş olayı ikinci kez yazılmaz (örn. `booking-captured:<paymentId>`).
  idempotencyKey String        @unique
  /// Şablon adı (BOOKING_CAPTURED, REFUND_ISSUED, …).
  kind           String
  /// Satırların kanonik özeti — aynı anahtarla farklı içerik 409 döner.
  linesHash      String
  bookingId      String?
  paymentId      String?
  transferId     String?
  occurredAt     DateTime
  memo           String?
  createdAt      DateTime      @default(now())
  lines          JournalLine[]

  @@index([bookingId])
  @@index([paymentId])
  @@index([transferId])
  @@index([occurredAt])
}

model JournalLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id])
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  side        JournalSide
  /// Pozitif minor-unit tutar (TRY: kuruş); yön `side` ile verilir.
  amountMinor BigInt
  currency    String

  @@index([entryId])
  @@index([accountId, currency])
}

/// P1-10 görsel zekâ (ADR 0022): host'un yüklediği fotoğraf. Bayt normalize WebP'dir
/// (EXIF/GPS silinmiş, uzun kenar sınırlı). Skorlar 0..1; `pHash` 64-bit DCT perceptual hash
/// (16 hex). `embedding` CLIP ViT-B/32 (L2-normalize, 512-d); model/bayrak yoksa null.
model PropertyPhoto {
  id                String                      @id @default(cuid())
  propertyId        String
  property          Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById      String?
  contentType       String
  data              Bytes
  width             Int
  height            Int
  byteSize          Int
  /// Laplacian varyansı (ham) ve 0..1 normalize netlik skoru.
  blurVariance      Float?
  blurScore         Float?
  /// Histogram tabanlı pozlama skoru (0..1; orta ton + kırpılmamış uçlar = yüksek).
  exposureScore     Float?
  qualityScore      Float?
  pHash             String?                     @db.Char(16)
  /// Yüklemede bulunan en yakın perceptual duplikat (Hamming ≤ eşik); yoksa null.
  duplicateOfId     String?
  duplicateOf       PropertyPhoto?              @relation("PhotoDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        PropertyPhoto[]             @relation("PhotoDuplicates")
  duplicateDistance Int?
  embedding         Unsupported("vector(512)")?
  embeddingModel    String?
  createdAt         DateTime                    @default(now())

  @@index([propertyId, createdAt])
  @@index([pHash])
  @@index([duplicateOfId])
}

/// P1-13a: 7565 s. Kanun kapsamında yetkili makam (Bakanlık) kaldırma talebi. İlan alındığı
/// anda pasife alınır; `slaDueAt` (alınma + TAKEDOWN_SLA_HOURS) geçtiğinde ilan hâlâ yayında
/// ya da talep işlenmemişse SLA aşımı (metrik + alarm). İlişki alanı yok (yalnız ekleme).
model TakedownRequest {
  id            String         @id @default(cuid())
  source        TakedownSource
  /// Resmî yazı / evrak numarası.
  referenceNo   String?
  propertyId    String
  reason        String
  receivedAt    DateTime
  slaDueAt      DateTime
  status        TakedownStatus @default(RECEIVED)
  actionedAt    DateTime?
  slaCheckedAt  DateTime?
  slaBreachedAt DateTime?
  createdById   String
  resolvedAt    DateTime?
  resolvedById  String?
  resolution    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([propertyId, status])
  @@index([status, slaDueAt])
}

enum TakedownSource {
  MINISTRY_7565
  COURT_ORDER
  OTHER_AUTHORITY
}

enum TakedownStatus {
  /// Alındı; ilan henüz pasife alınamadı.
  RECEIVED
  /// İlan pasif (kaldırma uygulandı).
  ACTIONED
  /// Yönetici kapattı (kaldırma sürer ya da talep geri çekildi → ilan yeniden açılabilir).
  CLOSED
}

/// P1-13b: DSA (AB 2022/2065) md. 16 bildirim-ve-eylem. Herkese açık formdan gelir;
/// karar md. 17 gerekçeli karar bildirimiyle (statement of reasons) e-postalanır.
model Notice {
  id                 String          @id @default(cuid())
  propertyId         String?
  contentUrl         String
  category           NoticeCategory
  explanation        String
  reporterName       String?
  reporterEmail      String
  goodFaith          Boolean
  locale             String          @default("tr")
  status             NoticeStatus    @default(RECEIVED)
  decision           NoticeDecision?
  decisionGround     NoticeGround?
  legalReference     String?
  statementOfReasons String?
  automated          Boolean         @default(false)
  decidedAt          DateTime?
  decidedById        String?
  createdAt          DateTime        @default(now())

  @@index([status, createdAt])
  @@index([propertyId])
}

enum NoticeCategory {
  ILLEGAL_LISTING
  UNLICENSED
  FRAUD_SCAM
  IP_INFRINGEMENT
  DISCRIMINATION
  UNSAFE
  OTHER
}

enum NoticeStatus {
  RECEIVED
  DECIDED
}

enum NoticeDecision {
  /// İçerik kaldırıldı / ilan pasife alındı.
  REMOVED
  /// İşlem yapılmadı.
  NO_ACTION
}

enum NoticeGround {
  /// Hukuka aykırı içerik (md. 17(3)(d)).
  ILLEGAL_CONTENT
  /// Kullanım koşullarına aykırılık (md. 17(3)(e)).
  TERMS_OF_SERVICE
}
