# booking-platform — ortam değişkenleri (yalnızca ADLAR; değerleri siz verin).
# `cp .env.example .env` → yerel geliştirme için gerekli alanları doldurun.
# docker compose demo'sunda sırlar boş bırakılabilir: `secrets-init` rastgele üretir.
# Aşağıdaki sayısal ayarların yorumlarında varsayılan değerler yazar.

# --- Uygulama ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Virgülle ayrık izinli origin'ler (CSRF Origin kontrolü)
APP_ORIGINS=
LOG_LEVEL=info
# production'da Secure çerez; yalnızca http demo için false
COOKIE_SECURE=
# 0 = doğrudan internete açık (X-Forwarded-For'a güvenme), 1 = bir ters proxy arkasında
TRUSTED_PROXY_HOPS=0

# --- Veritabanı (PostgreSQL + pgvector) ----------------------------------------
DATABASE_URL=postgresql://booking:CHANGE_ME@localhost:5432/booking?connection_limit=10&pool_timeout=15
POSTGRES_USER=booking
POSTGRES_PASSWORD=
POSTGRES_DB=booking
# Prisma sorgu profil'leyicisi (varsayılan kapalı)
ENABLE_QUERY_STATS=false

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- Kimlik doğrulama / sırlar (her biri en az 32 karakter rastgele) -------------------
JWT_SECRET=
INTERNAL_API_SECRET=
TRANSFER_SIGNING_SECRET=
# iCal akış tokenlarını imzalar
CHANNEL_FEED_SECRET=
PSP_WEBHOOK_SECRET=
# /api/metrics Bearer token'ı
METRICS_TOKEN=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800

# --- LLM (yoksa DEMO modu; ilk bulunan kazanır) --------------------------------------
# Anahtar: LLM_API_KEY → DEEPSEEK_API_KEY → EVREN_API_KEY → OPENAI_API_KEY
LLM_API_KEY=
# Base URL: LLM_BASE_URL → DEEPSEEK_BASE_URL → EVREN_BASE_URL → OPENAI_BASE_URL
# (varsayılan https://evren-llmapi.ssyz.org.tr/v1)
LLM_BASE_URL=
# Model: LLM_MODEL → DEEPSEEK_MODEL (varsayılan deepseek-v4-flash)
LLM_MODEL=
# auto | live | demo
LLM_MODE=auto
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800
# LLM_MAX_TOOL_STEPS=5
# Yalnızca geliştirmede, redakte hâliyle
LLM_LOG_PROMPTS=false
# Opsiyonel gerçek embedding modeli (boşsa ağsız hash-embedding)
EMBEDDING_MODEL=

# --- Ödeme -----------------------------------------------------------------
# mock | stripe (STRIPE_SECRET_KEY yoksa mock)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# --- E-posta (boşsa dev mailbox'a yazılır) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Servisler ----------------------------------------------------------------
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
# Boşsa Postgres araması kullanılır
ELASTICSEARCH_URL=
# Boşsa izleme (tracing) no-op
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=booking-web
# İşçi süreci Prometheus metrik portu
WORKER_METRICS_PORT=9464
# Statik kur tablosunu ezmek için JSON (ör. {"USD":0.029,"EUR":0.027})
FX_RATES_JSON=
# Demo seed'i production'da yalnızca açıkça true ise çalışır. Boş bırakılırsa docker compose
# demosu varsayılan olarak seed yükler (`${DEMO_SEED:-true}`); kapatmak için false yazın.
DEMO_SEED=

# --- İş kuralları (yorumdaki değerler varsayılandır) --------------------------------------
# BOOKING_HOLD_TTL_MINUTES=15
# MAX_STAY_NIGHTS=30
# QUOTE_TTL_MINUTES=15
# Konaklama vergisi (2026: %1)
# ACCOMMODATION_TAX_RATE=0.01
# Giriş saati (UTC; iptal süreleri için)
# CHECKIN_HOUR_UTC=12
# PRICE_FLOOR_MULTIPLIER=0.6
# PRICE_CEILING_MULTIPLIER=2.0
# EVENT_FACTOR_PER_POINT=0.05
# YIELD_HOLD_MAX_SHARE=0.2
# FEATURE_TRANSFER=true
# TRANSFER_MAX_ASK_RATIO=1.0
# TRANSFER_MIN_HOURS_BEFORE_CHECKIN=48
# TRANSFER_LINK_TTL_HOURS=168
# FRAUD_REVIEW_THRESHOLD=40
# FRAUD_BLOCK_THRESHOLD=80
# NEGOTIATION_MAX_ROUNDS=3
# ROUTING_MAX_CITIES=12
# ROUTING_FLIGHT_COST_PER_KM=0.09
# ROUTING_FLIGHT_COST_BASE=40

# --- Rate-limit ve canlı akış (pencere başına istek) ------------------------------------
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT_MAX=100
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_SEARCH_MAX=60
# RATE_LIMIT_BOOKING_MAX=30
# RATE_LIMIT_AI_MAX=20
# LIVE_MAX_RANGE_DAYS=60
# LIVE_MAX_CONNECTIONS_PER_IP=3
# LIVE_POLL_INTERVAL_MS=3000
# LIVE_VIEW_DEDUPE_SECONDS=600
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_LEASE_SECONDS=60
# OUTBOX_BACKOFF_BASE_MS=1000
