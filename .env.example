# App
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://booking:booking@localhost:5432/booking?connection_limit=10&pool_timeout=15
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-too
NEXTAUTH_URL=http://localhost:3000

# Internal service calls (outbox relay, gRPC bridge)
INTERNAL_API_SECRET=change-me-internal-secret

# SMTP (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change-me
