{
  "name": "booking-platform",
  "version": "3.0.0",
  "private": true,
  "description": "Çift rezervasyonu kanıtlı biçimde engelleyen, parayı tamsayı minor-unit ile hesaplayan ve GenAI'ı yalnızca açıklama/özet için kullanan konaklama rezervasyon (OTA) platformu — portföy/demo projesi",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:unit",
    "postinstall": "prisma generate",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "grpc:server": "tsx --conditions=react-server services/grpc/main.ts",
    "mcp:server": "cross-env LOG_TO_STDERR=true SERVICE_NAME=booking-mcp tsx --conditions=react-server services/mcp/main.ts",
    "mcp:smoke": "cross-env LOG_TO_STDERR=true tsx --conditions=react-server scripts/mcp-smoke.ts",
    "docs:screenshots": "tsx scripts/screenshots.ts",
    "embeddings:backfill": "tsx scripts/backfill-embeddings.ts",
    "ltr:clicks": "tsx scripts/ltr/generate-clicks.ts",
    "ltr:train": "python scripts/ltr/train.py",
    "llm:smoke": "tsx --conditions=react-server scripts/llm-smoke.ts",
    "availability:rollover": "tsx scripts/availability-rollover.ts",
    "sdep:export": "tsx scripts/sdep-export.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "demo:scenarios": "tsx scripts/demo-scenarios.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.7.15",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@prisma/client": "^5.22.0",
    "@prisma/instrumentation": "^5.22.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@vercel/otel": "^2.1.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.0",
    "dotenv": "^16.6.1",
    "ical-generator": "^11.1.1",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "maplibre-gl": "^6.11.2",
    "murmurhash": "^2.0.1",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "node-ical": "^0.27.2",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "supercluster": "^9.1.0",
    "tsx": "^4.16.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "fast-check": "^3.23.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.39",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.6",
    "testcontainers": "^12.1.0",
    "typescript": "^5.5.3",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.30.0"
  }
}
