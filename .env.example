# booking-platform — ortam değişkenleri (yalnızca ADLAR; değerleri siz verin).
# `cp .env.example .env` → yerel geliştirme için gerekli alanları doldurun.
# docker compose demo'sunda sırlar boş bırakılabilir: `secrets-init` rastgele üretir.
# Aşağıdaki sayısal ayarların yorumlarında varsayılan değerler yazar.

# --- Uygulama ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Virgülle ayrık izinli origin'ler (CSRF Origin kontrolü)
APP_ORIGINS=
LOG_LEVEL=info
# Logları stderr'e yaz (stdio protokollü süreçler için; `npm run mcp:server` kendisi ayarlar)
# LOG_TO_STDERR=false
# production'da Secure çerez (compose varsayılanı true); yalnızca http demo için false
COOKIE_SECURE=
# 0 = doğrudan internete açık (X-Forwarded-For'a güvenme), 1 = bir ters proxy arkasında
TRUSTED_PROXY_HOPS=0
# hops=0 iken önde x-real-ip'yi ezen tek bir ters vekil varsa true (yoksa parmak izi kovası)
# TRUST_REAL_IP_HEADER=false
# Demo modu: true → demo seed + /dev/mailbox + varsayılan MockPsp + "DEMO" rozeti.
# false → demo seed reddedilir, mailbox 404, ödeme sağlayıcısı açıkça seçilmeli.
# Boşsa: production dışı ortamlar (npm run dev) demo, production demo değil.
# docker compose varsayılanı false; demo için `-f docker-compose.demo.yml` override'ı (v4#5).
DEMO_MODE=

# --- Veritabanı (PostgreSQL + pgvector) ----------------------------------------
DATABASE_URL=postgresql://booking:CHANGE_ME@localhost:5432/booking?connection_limit=10&pool_timeout=15
POSTGRES_USER=booking
POSTGRES_PASSWORD=
POSTGRES_DB=booking
# Prisma sorgu profil'leyicisi (varsayılan kapalı)
ENABLE_QUERY_STATS=false

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# --- Kimlik doğrulama / sırlar (her biri en az 32 karakter rastgele) -------------------
JWT_SECRET=
INTERNAL_API_SECRET=
TRANSFER_SIGNING_SECRET=
# iCal akış tokenlarını imzalar
CHANNEL_FEED_SECRET=
PSP_WEBHOOK_SECRET=
# /api/metrics Bearer token'ı
METRICS_TOKEN=
# ACCESS_TOKEN_TTL_SECONDS=300
# REFRESH_TOKEN_TTL_SECONDS=604800
# Hesap kilidi: art arda N başarısız giriş → M dakika kilit
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
# Şifre sıfırlama bağlantısı ömrü (dk) ve e-posta doğrulama bağlantısı ömrü (saat)
# AUTH_RESET_TOKEN_TTL_MINUTES=30
# AUTH_VERIFY_TOKEN_TTL_HOURS=24
# v4#12: hesap kilitlenmez; AUTH_LOCKOUT_THRESHOLD başarısızlıktan sonra PoW istenir,
# AUTH_LOCKOUT_MINUTES başarısızlık sayaçlarının penceresidir.
# (istemci, e-posta) başına gecikmesiz deneme; sonra üstel gecikme (taban/tavan ms)
# AUTH_LOGIN_FREE_FAILURES=3
# AUTH_LOGIN_DELAY_BASE_MS=1000
# AUTH_LOGIN_DELAY_MAX_MS=30000
# İş kanıtı zorluğu (bit) ve bulmaca ömrü (sn)
# AUTH_POW_DIFFICULTY_BITS=16
# AUTH_POW_TTL_SECONDS=300
# Giriş / şifre sıfırlama asgari yanıt süresi (ms)
# AUTH_MIN_RESPONSE_MS=300
# E-posta başına pencere (sn) içinde en çok şifre sıfırlama e-postası
# AUTH_RESET_PER_EMAIL_MAX=3
# AUTH_RESET_WINDOW_SECONDS=3600
# Passkey (WebAuthn): tarayıcıdaki alan adı ve origin
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=booking-platform
# WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# --- LLM (yoksa DEMO modu; ilk bulunan kazanır) --------------------------------------
# Anahtar: LLM_API_KEY → DEEPSEEK_API_KEY → EVREN_API_KEY → OPENAI_API_KEY
LLM_API_KEY=
# Base URL: LLM_BASE_URL → DEEPSEEK_BASE_URL → EVREN_BASE_URL → OPENAI_BASE_URL
# (varsayılan https://evren-llmapi.ssyz.org.tr/v1)
LLM_BASE_URL=
# Model: LLM_MODEL → DEEPSEEK_MODEL (varsayılan deepseek-v4-flash)
LLM_MODEL=
# auto | live | demo
LLM_MODE=auto
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=800
# LLM_MAX_TOOL_STEPS=5
# Kullanıcı başına günlük token bütçesi (0 = sınırsız); aşımda demo + reason "budget"
# LLM_DAILY_TOKEN_BUDGET_PER_USER=50000
# Süreç başına eşzamanlı LLM/embedding isteği üst sınırı (v4)
# LLM_MAX_CONCURRENCY=4
# Opsiyonel görsel model (boşsa görsel özellikler deterministik yola düşer)
LLM_VISION_MODEL=
# Yalnızca geliştirmede, redakte hâliyle (debug seviyesi)
LLM_LOG_PROMPTS=false
# Opsiyonel gerçek embedding modeli (boşsa ağsız hash-embedding)
EMBEDDING_MODEL=

# --- Ödeme -----------------------------------------------------------------
# mock | stripe. Boşsa yalnızca demo modunda mock; stripe seçilip anahtar yoksa açılış hatası.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
# Stripe webhook imza sırrı (whsec_…); Stripe-Signature başlığı constructEvent ile doğrulanır
STRIPE_WEBHOOK_SECRET=
# Payment Element için yayımlanabilir anahtar (pk_test_…); istemciye gider, sır değildir
STRIPE_PUBLISHABLE_KEY=
# Devir sonrası satıcı ödemesi (mock payout) işinin cron'u (UTC)
# PAYOUT_CRON=*/15 * * * *

# --- E-posta (boşsa dev mailbox'a yazılır) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Servisler ----------------------------------------------------------------
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
# gRPC TLS (PEM dosya yolları). CERT+KEY → TLS; CA da verilirse istemci sertifikası zorunlu.
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_TLS_CA=
# İstemci tarafı mTLS (opsiyonel)
GRPC_TLS_CLIENT_CERT=
GRPC_TLS_CLIENT_KEY=
# MCP stdio sunucusu (npm run mcp:server): kimlik bu ortam değişkeninden gelir — araç
# argümanlarında kimlik bilgisi YOKTUR. Boşsa create_hold UNAUTHORIZED döner.
MCP_ACCESS_TOKEN=
# Boşsa izleme (tracing) no-op
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=booking-web
# İşçi süreci Prometheus metrik portu
WORKER_METRICS_PORT=9464
# Statik kur tablosunu ezmek için JSON (ör. {"USD":0.029,"EUR":0.027}) — ağ yokken yedek
FX_RATES_JSON=
# Kalıcı kur (P0-5): sırayla denenecek kaynaklar; "none" → ağ yok, yalnızca statik tablo
# FX_SOURCES=tcmb,ecb
# FX_TCMB_URL=https://www.tcmb.gov.tr/kurlar/today.xml
# FX_ECB_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
# FX_FETCH_TIMEOUT_MS=5000
# Günlük fx-refresh işi (cron, UTC)
# FX_REFRESH_CRON=45 12 * * *
# FX_STALE_HOURS=72
# Bu kadar günden eski ve hiçbir rezervasyonun bağlı olmadığı kur satırları silinir (en yenisi kalır)
# FX_RETENTION_DAYS=90
# FX_CACHE_SECONDS=60
# Tesis para birimi dışında tahsilat yapılabilecek birimler (ör. USD,EUR); boş → yalnızca tesis
# FX_CHARGE_CURRENCIES=
# Opsiyonel gözlemlenebilirlik profili host portları (başka projelerle çakışırsa değiştirin)
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# --- İş kuralları (yorumdaki değerler varsayılandır) --------------------------------------
# BOOKING_HOLD_TTL_MINUTES=15
# MAX_STAY_NIGHTS=30
# QUOTE_TTL_MINUTES=15
# Grup sepeti (P1-1): en fazla kalem ve tümü-ya-hiç tutma süresi (dk)
# CART_MAX_ITEMS=10
# CART_HOLD_TTL_MINUTES=15
# Rezervasyon detay önbelleği (sn) ve liste sayfalaması (v4#14)
# BOOKING_CACHE_TTL_SECONDS=600
# BOOKINGS_PAGE_SIZE_DEFAULT=50
# BOOKINGS_PAGE_SIZE_MAX=100
# Vergi/ücret kuralları (P0-4): boşsa data/tax-rules.json (TR KDV %10 dahil, konaklama
# vergisi %2; 1 Mayıs–31 Aralık 2026 %1). JSON dizi ya da {"rules":[...]} kabul edilir.
# TAX_RULES_JSON=
# Platform hizmet bedeli (baz puan, 0 = yok)
# SERVICE_FEE_BPS=0
# Geçmiş envanter günlerinin saklama süresi (gün); giriş/çıkış saati tesis bazında (Property)
# INVENTORY_RETENTION_DAYS=400
# PRICE_FLOOR_MULTIPLIER=0.6
# PRICE_CEILING_MULTIPLIER=2.0
# EVENT_FACTOR_PER_POINT=0.05
# YIELD_HOLD_MAX_SHARE=0.2
# Host gelir paneli (P1-5): KPI penceresi (gece), pickup geçmişi (gün), öneri ufku (gece)
# REVENUE_WINDOW_DAYS=30
# REVENUE_PICKUP_DAYS=30
# REVENUE_SUGGESTION_DAYS=14
# Hedef doluluk ve sapma ağırlığı: çarpan = 1 + ağırlık × (doluluk − hedef)
# REVENUE_OCCUPANCY_TARGET=0.7
# REVENUE_OCCUPANCY_WEIGHT=0.5
# Son dakika (gün) indirimi (baz puan) — yalnız hedefin altındaki doluluğa
# REVENUE_LAST_MINUTE_DAYS=3
# REVENUE_LAST_MINUTE_DISCOUNT_BPS=1000
# Resmî tatil/bayram gecesi artışı (baz puan); öneri her zaman [taban, tavan] içinde kalır
# REVENUE_HOLIDAY_UPLIFT_BPS=1500
# Öneri açıklaması LLM önbelleği (sn; 0 = kapalı)
# REVENUE_EXPLAIN_CACHE_TTL_SECONDS=86400
# Fiyat içgörüsü: split conformal hata oranı (0.1 → %90 aralık), asgari kalibrasyon, pencere (gün)
# PRICE_INSIGHT_ALPHA=0.1
# PRICE_INSIGHT_MIN_CALIBRATION=20
# PRICE_INSIGHT_WINDOW_DAYS=90
# Omnibus "önceki fiyat" = son N günün en düşüğü; günlük fiyat alarmı işi (cron, UTC); kullanıcı başına azami alarm
# PRICE_OMNIBUS_DAYS=30
# PRICE_ALERT_CRON=15 6 * * *
# PRICE_ALERT_MAX_PER_USER=20
# Promosyon motoru (P1-8): toplam indirim üst sınırı (bps) ve ev sahibi başına azami promosyon
# PROMOTION_MAX_DISCOUNT_BPS=9000
# PROMOTION_MAX_PER_HOST=100
# FEATURE_TRANSFER=true
# TRANSFER_MAX_ASK_RATIO=1.0
# TRANSFER_MIN_HOURS_BEFORE_CHECKIN=48
# TRANSFER_LINK_TTL_HOURS=168
# Çöken devir sagası: CAPTURE_PENDING'de takılan devirleri süpür (sn) — void/iade + FAILED
# TRANSFER_CAPTURE_PENDING_TIMEOUT_SECONDS=900
# TRANSFER_SWEEP_CRON=*/5 * * * *
# Defter (P0-3): günlük PSP ↔ jurnal mutabakatı (UTC, dünün kayıtları)
# LEDGER_RECONCILE_CRON=45 2 * * *
# P1-13: 7565 kaldırma talebi SLA (saat) + yedek SLA süpürücü (UTC cron)
# TAKEDOWN_SLA_HOURS=24
# TAKEDOWN_SLA_SWEEP_CRON=*/10 * * * *
# DSA bildirim formu: istemci başına pencere içinde en fazla bildirim / pencere (sn)
# DSA_NOTICE_MAX_PER_WINDOW=5
# DSA_NOTICE_WINDOW_SECONDS=3600
# PWA + Web Push (P1-12): VAPID anahtarları yoksa push KAPALI (UI açıklar).
# Üretmek için: npx web-push generate-vapid-keys  (özel anahtarı sır olarak saklayın)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# İzinli push servisi alan adları (SSRF koruması), cihaz sınırı, TTL (sn), gönderim zaman aşımı (ms)
# PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,web.push.apple.com,*.push.apple.com,*.notify.windows.com
# PUSH_MAX_SUBSCRIPTIONS_PER_USER=10
# PUSH_TTL_SECONDS=86400
# PUSH_SEND_TIMEOUT_MS=10000
# Check-in hatırlatma (cron, UTC) ve kaç gün önce
# PUSH_CHECKIN_REMINDER_CRON=0 7 * * *
# PUSH_CHECKIN_REMINDER_DAYS_AHEAD=1
# Service worker kaydını kapatır (derleme zamanı; yalnızca üretim derlemesinde kayıt yapılır)
# NEXT_PUBLIC_PWA_DISABLED=false
# Fraud v2 eşikleri (skor 0–100): allow < challenge_3ds < step_up_passkey < review < deny
# FRAUD_CHALLENGE_THRESHOLD=30
# FRAUD_STEP_UP_THRESHOLD=45
# FRAUD_REVIEW_THRESHOLD=60
# FRAUD_BLOCK_THRESHOLD=80
# Hız kuralları (kullanıcı/10 dk, istemci/saat, kart/saat) ve yeni hesapta yüksek tutar (minor-unit)
# FRAUD_VELOCITY_USER_MAX=3
# FRAUD_VELOCITY_IP_MAX=10
# FRAUD_VELOCITY_CARD_MAX=5
# FRAUD_HIGH_AMOUNT_MINOR=2000000
# Cihaz izi: aynı cihazda azami hesap; eşleşme saklama süresi (gün)
# FRAUD_DEVICE_MAX_ACCOUNTS=3
# FRAUD_DEVICE_TTL_DAYS=90
# Passkey step-up doğrulamasının geçerliliği (sn, tek kullanımlık)
# STEP_UP_TTL_SECONDS=300
# Mesajlaşma: azami mesaj uzunluğu, thread başına mesaj, SSE heartbeat (ms)
# MESSAGE_MAX_LENGTH=2000
# MESSAGE_PAGE_SIZE=200
# MESSAGE_SSE_HEARTBEAT_MS=25000
# Bu kadar kullanıcı şikâyeti alan yorum otomatik gizlenir
# REVIEW_REPORT_HIDE_THRESHOLD=3
# Kanal yöneticisi: iCal yoklama aralığı (dk), tur başına abonelik, zaman aşımı (ms), azami gövde (bayt)
# ICAL_POLL_MINUTES=30
# ICAL_POLL_BATCH=50
# ICAL_FETCH_TIMEOUT_MS=10000
# ICAL_MAX_BYTES=1000000
# Tek çekimin toplam süre sınırı (ms) ve tur başına eşzamanlı çekim
# ICAL_FETCH_DEADLINE_MS=30000
# ICAL_POLL_CONCURRENCY=4
# Parite uyarısı eşiği (baz puan) — yalnızca uyarı, fiyat asla zorlanmaz (DMA)
# CHANNEL_PARITY_TOLERANCE_BPS=100
# Ajan checkout oturumu (ACP) geçerlilik süresi (dk)
# CHECKOUT_SESSION_TTL_MINUTES=30
# ROUTING_MAX_CITIES=12
# ROUTING_FLIGHT_COST_PER_KM=0.09
# ROUTING_FLIGHT_COST_BASE=40

# --- Rate-limit ve canlı akış (pencere başına istek) ------------------------------------
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT_MAX=100
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_SEARCH_MAX=60
# RATE_LIMIT_BOOKING_MAX=30
# RATE_LIMIT_AI_MAX=20
# MCP HTTP + ajan checkout uçları (pencere başına; Redis yoksa fail-closed)
# RATE_LIMIT_AGENTIC_MAX=30
# IP bilinmeyen anonimlerin paylaştığı kova = kategori limiti x bu çarpan (v4#4)
# RATE_LIMIT_ANON_SHARED_MULTIPLIER=20
# Hesap (e-posta) başına giriş denemesi / pencere — IP'den bağımsız
# RATE_LIMIT_LOGIN_PER_ACCOUNT_MAX=10
# LIVE_MAX_RANGE_DAYS=60
# LIVE_MAX_CONNECTIONS_PER_IP=3
# LIVE_POLL_INTERVAL_MS=3000
# LIVE_VIEW_DEDUPE_SECONDS=600
# İstemci (IP) başına pencerede basılabilecek yeni canlı-izleyici çerezi (v4#18)
# LIVE_VIEWER_MINT_MAX=20
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_LEASE_SECONDS=60
# OUTBOX_BACKOFF_BASE_MS=1000
# Tek Redis komutunun üst süresi (ms). Bağlantı kopunca komutlar zaten beklemeden reddedilir.
# REDIS_COMMAND_TIMEOUT_MS=1000
# SERIALIZABLE işlemde serileştirme çakışması (P2034) → toplam deneme sayısı ve
# üstel geri çekilme tabanı (ms, rastgele pay eklenir). Tükenirse 409 TRANSACTION_CONFLICT.
# DB_SERIALIZABLE_RETRY_ATTEMPTS=6
# DB_SERIALIZABLE_RETRY_BASE_MS=15

# --- Hibrit arama (P1-1), LTR (P1-2), deneyler (P1-3) --------------------------
# RRF sabiti: skor = Σ 1/(k + sıra)
# SEARCH_RRF_K=60
# Kanal başına (sözcüksel/vektör/trigram) aday sınırı
# SEARCH_HYBRID_CANDIDATES=200
# Vektör kanalına girmek için en düşük kosinüs benzerliği
# SEARCH_HYBRID_MIN_SIMILARITY=0.2
# Trigram (yazım hatası) kanalı için en düşük word_similarity
# SEARCH_HYBRID_MIN_TRGM=0.45
# LightGBM→ONNX sıralama modeli (yoksa / onnxruntime yüklenemezse ağırlıklı sıralama)
# LTR_MODEL_PATH=models/ranker.onnx
# --- P1-10 görsel zekâ & çok-modlu arama (ADR 0022) ---
# CLIP görsel embedding + "bu fotoğraftaki gibi" arama (kapalıysa API/UI açıklama döner;
# kalite skoru ve pHash duplikat uyarısı bayraktan bağımsız çalışır)
# VISION_CLIP_ENABLED=false
# VISION_CLIP_MODEL=Xenova/clip-vit-base-patch32
# Model önbelleği (npm run vision:download ile doldurulur; repoya girmez)
# VISION_MODEL_DIR=models/transformers
# Yerel model yoksa HF Hub'dan indirmeye izin ver
# VISION_ALLOW_REMOTE_MODELS=false
# VISION_MAX_UPLOAD_BYTES=10485760
# VISION_MAX_EDGE_PX=1600
# VISION_MAX_PHOTOS_PER_PROPERTY=40
# Laplacian varyansının netlik skorunu 1'e doyurduğu değer
# VISION_BLUR_VARIANCE_GOOD=300
# VISION_QUALITY_BLUR_WEIGHT=0.6
# VISION_LOW_QUALITY_THRESHOLD=0.35
# pHash Hamming eşiği (64 bit; ≤ eşik → duplikat uyarısı)
# VISION_DUPLICATE_MAX_HAMMING=8
# Görsel kNN kanalı için en düşük kosinüs benzerliği
# VISION_MIN_SIMILARITY=0.75
# --- v4 P1-9: AI yorum öne çıkanları + ilan karşılaştırma ---
# REVIEW_HIGHLIGHTS_MAX_REVIEWS=50
# REVIEW_HIGHLIGHTS_MIN_REVIEWS=2
# REVIEW_HIGHLIGHTS_MAX_CLUSTERS=4
# REVIEW_HIGHLIGHTS_KMEANS_SEED=42
# REVIEW_HIGHLIGHTS_KMEANS_MAX_ITERATIONS=50
# REVIEW_HIGHLIGHTS_MAX_CLAIMS=3
# Birebir alıntının en az karakter sayısı
# REVIEW_HIGHLIGHTS_MIN_QUOTE_CHARS=12
# Öne çıkanlar önbelleği (sn; anahtar = yorum seti karması)
# REVIEW_HIGHLIGHTS_CACHE_TTL_SECONDS=86400
# COMPARE_MIN_LISTINGS=2
# COMPARE_MAX_LISTINGS=4
# --- v4 P1-3: esnek tarih fiyat takvimi + arama ±N gün ---
# Takvim ufku (gün) ve fiyatın varsaydığı misafir sayısı (kişi başı vergiler)
# PRICE_CALENDAR_HORIZON_DAYS=365
# PRICE_CALENDAR_GUESTS=1
# Tam yeniden hesaplama (UTC cron); artımlı işler envanter/fiyat/rezervasyon olaylarından
# PRICE_CALENDAR_REFRESH_CRON=20 3 * * *
# PRICE_CALENDAR_DEBOUNCE_MS=2000
# "Ucuz gün" bandı: ayın en ucuzunun en fazla bu kadar bps üstü
# PRICE_CALENDAR_CHEAP_BAND_BPS=1000
# SEARCH_FLEX_MAX_DAYS=3
# Anonim deney bucket çerezi (exp_sid) ömrü, gün — yalnız analitik onayı varsa yazılır
# EXPERIMENT_COOKIE_DAYS=90

# --- Geliştirici betikleri ---------------------------------------------------
# npm run docs:screenshots hedefi (varsayılan http://localhost:3000)
# SCREENSHOT_BASE_URL=http://localhost:3000
# npm run demo:scenarios (ve load/*.js k6 betikleri) hedefi (varsayılan http://localhost:3000)
# BASE_URL=http://localhost:3000
# Demo senaryolarının/k6 betiklerinin kullandığı gece ofseti, gün (demo: 1..340; boşsa 150..339 arası rastgele)
# DAY_OFFSET=
# npm run ltr:clicks ile üretilecek sentetik sorgu sayısı (varsayılan 3000)
# LTR_QUERIES=3000

# --- v4 F1-B: hassas işlem güvenliği ve ödeme sağlamlığı -------------------------
# Hassas işlemler (passkey ekle/sil, hesap sil) için son kimlik doğrulamanın azami yaşı (sn)
# RECENT_AUTH_MAX_AGE_SECONDS=300
# Yeniden doğrulama (parola) deneme sınırı ve penceresi (sn), kullanıcı başına
# REAUTH_MAX_ATTEMPTS=5
# REAUTH_WINDOW_SECONDS=900
# Yeni passkey bu kadar saat ödeme step-up'ında kullanılamaz (0 → soğuma yok)
# PASSKEY_STEP_UP_COOLDOWN_HOURS=24
# Rezervasyon başına başarısız ödeme/3DS denemesi sınırı ve sayaç ömrü (sn)
# PAYMENT_MAX_ATTEMPTS=5
# PAYMENT_ATTEMPTS_WINDOW_SECONDS=86400
# Sunucu imzalı cihaz kimliği çerezi (did) ömrü, gün
# DEVICE_COOKIE_DAYS=365
# Başarısız PSP iadesi: BullMQ refund-retry deneme sayısı ve üstel gecikme tabanı (ms)
# REFUND_RETRY_MAX_ATTEMPTS=8
# REFUND_RETRY_BASE_DELAY_MS=30000

# --- P1-6 KYC ve güven-emniyet (karar kodda; LLM yalnızca ek sinyal) ----------------------
# auto | mock | stripe. auto → STRIPE_SECRET_KEY + STRIPE_IDENTITY_WEBHOOK_SECRET varsa Stripe Identity, yoksa deterministik mock
# KYC_PROVIDER=auto
# Stripe Identity webhook imza sırrı (whsec_…); /api/trust/kyc/webhook
STRIPE_IDENTITY_WEBHOOK_SECRET=
# Mock KYC webhook HMAC sırrı (≥32 karakter); boşsa JWT sırrından türetilir
KYC_MOCK_WEBHOOK_SECRET=
# KYC_REQUIRED_FOR_HOSTS=false
# KYC_REQUIRED_FOR_GUESTS=false
# KYC_MAX_STARTS_PER_DAY=5
# Mesaj dolandırıcılık taraması: uyarı/yüksek risk skorları, yüksek riskte engelleme, opsiyonel LLM sinyali
# MESSAGE_SCAN_ENABLED=true
# MESSAGE_SCAN_WARN_SCORE=30
# MESSAGE_SCAN_HIGH_SCORE=60
# MESSAGE_SCAN_BLOCK_HIGH_RISK=false
# MESSAGE_SCAN_LLM_ENABLED=false
# Alan adı listeleri (virgülle ayrılmış; boşsa koddaki varsayılan)
# MESSAGE_SCAN_SHORTENER_DOMAINS=bit.ly,tinyurl.com,...
# MESSAGE_SCAN_PAYMENT_DOMAINS=paypal.me,wise.com,...
# MESSAGE_SCAN_MESSENGER_DOMAINS=wa.me,t.me,...
# Parti riski skoru (0–100): eşik, ağırlıklar ve kural eşikleri (docs/METHODOLOGY.md)
# PARTY_RISK_ENABLED=true
# PARTY_RISK_THRESHOLD=60
# PARTY_RISK_YOUNG_ACCOUNT_DAYS=30
# PARTY_RISK_WEIGHT_YOUNG_ACCOUNT=20
# PARTY_RISK_WEIGHT_SINGLE_NIGHT=20
# PARTY_RISK_LARGE_GROUP_MIN=6
# PARTY_RISK_WEIGHT_LARGE_GROUP=30
# PARTY_RISK_NEAR_DATE_DAYS=2
# PARTY_RISK_WEIGHT_NEAR_DATE=20
# PARTY_RISK_WEIGHT_WEEKEND=10
