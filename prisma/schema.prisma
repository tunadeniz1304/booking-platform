generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String
  avatarUrl           String?
  role                UserRole             @default(USER)
  /// Oturum dönemi: artırıldığında bu kullanıcının TÜM erişim/yenileme token'ları geçersizleşir
  /// (hesap silme, rol değişimi, şifre sıfırlama — v3#5).
  tokenVersion        Int                  @default(0)
  emailVerifiedAt     DateTime?
  /// Art arda başarısız giriş sayısı ve kilit bitişi (AUTH_LOCKOUT_*).
  failedLoginCount    Int                  @default(0)
  lockedUntil         DateTime?
  deletedAt           DateTime?
  authTokens          AuthToken[]
  webAuthnCredentials WebAuthnCredential[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookings            Booking[]
  reviews             Review[]
  favorites           Favorite[]
  payments            Payment[]
  properties          Property[]
  listedTransfers     BookingTransfer[]    @relation("transferSeller")
  claimedTransfers    BookingTransfer[]    @relation("transferBuyer")
}

enum UserRole {
  USER
  HOST
  ADMIN
}

model Property {
  id                   String                      @id @default(cuid())
  hostId               String
  host                 User                        @relation(fields: [hostId], references: [id])
  title                String
  description          String
  propertyType         PropertyType
  locationId           String
  location             Location                    @relation(fields: [locationId], references: [id])
  amenities            Amenity[]                   @relation("PropertyAmenities")
  /// Oda tipleri (v3 P0-2): satış birimi oda tipidir; `units` adet oda.
  rooms                RoomType[]
  /// IANA saat dilimi; gece, iade penceresi, iCal ve checkout sonrası tamamlama bu dilimde (ADR 0011).
  timeZone             String                      @default("Europe/Istanbul")
  /// Yerel giriş/çıkış saati (SS:DD).
  checkInTime          String                      @default("15:00")
  checkOutTime         String                      @default("11:00")
  bookings             Booking[]
  reviews              Review[]
  favorites            Favorite[]
  basePrice            Decimal                     @db.Decimal(10, 2)
  currency             String                      @default("TRY")
  ratingAvg            Float                       @default(0)
  ratingCount          Int                         @default(0)
  isActive             Boolean                     @default(true)
  images               String[]                    @default([])
  embedding            Unsupported("vector(128)")?
  priceHistory         PriceHistory[]
  /// İptal politikası (yoksa varsayılan MODERATE); rezervasyonda snapshot'ı alınır.
  /// Turizm İşletme Belgesi / 7464 izin belgesi no (ör. 34-12345); boşsa ilan yayınlanmaz.
  licenseNumber        String?
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy?         @relation(fields: [cancellationPolicyId], references: [id])
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([locationId, isActive])
  @@index([hostId])
  @@index([propertyType, isActive])
  @@index([ratingAvg])
}

enum PropertyType {
  HOTEL
  APARTMENT
  VILLA
  HOSTEL
  BED_AND_BREAKFAST
}

model Location {
  id           String        @id @default(cuid())
  city         String
  country      String
  latitude     Float?
  longitude    Float?
  properties   Property[]
  demandEvents DemandEvent[]

  @@unique([city, country])
  @@index([city])
  @@index([country])
}

model DemandEvent {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id])
  title      String
  startsAt   DateTime          @db.Date
  endsAt     DateTime          @db.Date
  // Talep etkisi 1-10; fiyat motoru yakınlıkla ağırlıklar.
  impact     Int               @default(5)
  /// Öneri → onay akışı: yalnızca APPROVED olaylar fiyata yansır.
  status     DemandEventStatus @default(APPROVED)
  category   String?
  rationale  String?
  source     String?
  proposedBy String?
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([locationId, startsAt])
  @@index([startsAt, endsAt])
  @@index([status, locationId])
}

enum DemandEventStatus {
  PROPOSED
  APPROVED
  REJECTED
  ROLLED_BACK
}

model Amenity {
  id         String     @id @default(cuid())
  name       String     @unique
  icon       String?
  properties Property[] @relation("PropertyAmenities")
}

/// Oda tipi (v3 P0-2, ADR 0010): "Standart Çift × 12". API'de `roomId` = oda tipi kimliği.
model RoomType {
  id             String          @id @default(cuid())
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id])
  name           String
  description    String?
  /// Bir odada kalabilecek azami kişi.
  maxOccupancy   Int
  /// Bu tipten kaç oda satılabilir (günlük `InventoryDay.total` varsayılanı).
  units          Int             @default(1)
  bedType        String
  priceModifier  Decimal         @default(0) @db.Decimal(10, 2)
  available      Boolean         @default(true)
  inventory      InventoryDay[]
  ratePlans      RatePlan[]
  restrictions   Restriction[]
  externalBlocks ExternalBlock[]
  bookings       Booking[]

  @@index([propertyId])
  @@index([available])
}

/// Gecelik sayaçlı envanter: `sold + held <= total` (CHECK kısıtı migration'da).
model InventoryDay {
  id               String   @id @default(cuid())
  roomTypeId       String
  roomType         RoomType @relation(fields: [roomTypeId], references: [id])
  date             DateTime @db.Date
  total            Int
  sold             Int      @default(0)
  held             Int      @default(0)
  price            Decimal  @db.Decimal(10, 2)
  /// "Bu fiyat neden?": taban, faktör-başı katkılar ve tavan/taban kırpması.
  priceExplanation Json?

  @@unique([roomTypeId, date])
  @@index([date])
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

/// Fiyat planı: aynı oda tipinin farklı koşullarla satışı (kahvaltılı, iade edilemez…).
model RatePlan {
  id                   String              @id @default(cuid())
  roomTypeId           String
  roomType             RoomType            @relation(fields: [roomTypeId], references: [id])
  code                 String
  name                 String
  mealPlan             MealPlan            @default(ROOM_ONLY)
  refundable           Boolean             @default(true)
  /// Planın kendi iptal politikası (yoksa mülkünki; iade edilemezse NON_REFUNDABLE).
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id])
  /// Gece fiyatına baz puan farkı (−1000 = %10 indirim, +1200 = %12 fark).
  priceModifierBps     Int                 @default(0)
  isDefault            Boolean             @default(false)
  active               Boolean             @default(true)
  bookings             Booking[]
  createdAt            DateTime            @default(now())

  @@unique([roomTypeId, code])
  @@index([roomTypeId, active])
}

/// Gece bazlı satış kısıtı (LOS / CTA / CTD / stop-sell).
model Restriction {
  id                String   @id @default(cuid())
  roomTypeId        String
  roomType          RoomType @relation(fields: [roomTypeId], references: [id])
  date              DateTime @db.Date
  minStay           Int?
  maxStay           Int?
  closedToArrival   Boolean  @default(false)
  closedToDeparture Boolean  @default(false)
  stopSell          Boolean  @default(false)

  @@unique([roomTypeId, date])
}

/// Harici kanaldan (iCal) gelen dolu aralık: başka kanalda satılmış birimler (`sold`'a sayılır).
model ExternalBlock {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  source     String
  uid        String
  date       DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([roomTypeId, source, uid, date])
  @@index([roomTypeId, source])
}

model Booking {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  propertyId     String
  property       Property          @relation(fields: [propertyId], references: [id])
  /// Oda tipi kimliği (geriye uyum için alan adı `roomId`).
  roomId         String
  room           RoomType          @relation(fields: [roomId], references: [id])
  ratePlanId     String?
  ratePlan       RatePlan?         @relation(fields: [ratePlanId], references: [id])
  /// Rezerve edilen oda adedi (sayaçlardan bu kadar düşülür).
  units          Int               @default(1)
  checkIn        DateTime          @db.Date
  checkOut       DateTime          @db.Date
  guestCount     Int
  totalPrice     Decimal           @db.Decimal(10, 2)
  currency       String            @default("TRY")
  status         BookingStatus     @default(PENDING)
  /// HELD durumundaki geçici tutma süresi; dolunca expire-holds işi envanteri iade eder.
  holdExpiresAt  DateTime?
  /// İyimser eşzamanlılık sürümü: her durum geçişinde +1 (koşullu güncelleme).
  version        Int               @default(0)
  /// computeTotal() kırılımının anlık görüntüsü (geceler, ara toplam, vergiler, toplam; minor-unit).
  priceBreakdown Json?
  quoteId        String?
  /// Rezervasyon anındaki iptal politikası (sonradan değişse de bu geçerlidir).
  policySnapshot Json?
  /// Rezervasyon anındaki kur tablosu (yalnızca görüntüleme karşılıkları için).
  fxSnapshot     Json?
  ledgerEntries  LedgerEntry[]
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  expiredAt      DateTime?
  idempotencyKey String?
  payment        Payment?
  reviews        Review[]
  transfers      BookingTransfer[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([status, checkIn])
  @@index([status, holdExpiresAt])
}

/// PENDING → HELD → CONFIRMED → COMPLETED | CANCELLED | EXPIRED (src/lib/booking/state-machine.ts)
enum BookingStatus {
  PENDING
  HELD
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])
  /// Ödemenin sahibi = rezervasyonun güncel sahibi (devirde alıcıya geçer).
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("TRY")
  provider       String
  /// PSP tarafındaki ödeme kimliği (mock: pi_mock_…, stripe: pi_…).
  providerRef    String?       @unique
  status         PaymentStatus @default(PENDING)
  refundedAmount Decimal       @default(0) @db.Decimal(10, 2)
  failureCode    String?
  authorizedAt   DateTime?
  paidAt         DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider, status])
}

/// PSP webhook olayları — olay kimliği benzersiz: replay ikinci kez etki etmez.
model PaymentEvent {
  id          String   @id
  type        String
  providerRef String?
  receivedAt  DateTime @default(now())

  @@index([providerRef])
}

enum LedgerKind {
  CHARGE
  REFUND
  TRANSFER_PAYMENT
  TRANSFER_PAYOUT
}

/// Para hareketleri defteri (escrow/devir izlenebilirliği).
model LedgerEntry {
  id        String     @id @default(cuid())
  bookingId String
  booking   Booking    @relation(fields: [bookingId], references: [id])
  userId    String
  kind      LedgerKind
  amount    Decimal    @db.Decimal(10, 2)
  currency  String
  reference String?
  createdAt DateTime   @default(now())

  @@index([bookingId])
  @@index([userId])
}

enum CancellationPolicyKind {
  NON_REFUNDABLE
  FLEXIBLE
  MODERATE
  STRICT
}

/// Sürümlü iptal politikası; kurallar: { tiers: [{ hoursBefore, refundPercent }], graceHours? }.
model CancellationPolicy {
  id         String                 @id @default(cuid())
  kind       CancellationPolicyKind
  version    Int                    @default(1)
  rules      Json
  createdAt  DateTime               @default(now())
  properties Property[]
  ratePlans  RatePlan[]

  @@unique([kind, version])
}

/// Bildirim kutusu (SMTP yoksa dev mailbox). dedupeKey: aynı olay iki kez → tek e-posta.
model Notification {
  id        String    @id @default(cuid())
  dedupeKey String    @unique
  channel   String    @default("email")
  userId    String?
  to        String
  subject   String
  text      String
  html      String
  status    String    @default("PENDING")
  transport String    @default("mailbox")
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  /// Tahsil edildi (capture)
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

model Review {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id])
  rating        Int
  comment       String?
  /// Ev sahibinin herkese açık yanıtı.
  hostReply     String?
  hostRepliedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([propertyId])
  @@index([userId])
  @@index([propertyId, rating])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([propertyId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  /// Azami deneme aşıldı; admin panelinden yeniden kuyruğa alınabilir.
  DEAD
}

model OutboxMessage {
  id             String       @id @default(cuid())
  eventType      String
  aggregateId    String
  aggregateType  String
  payload        Json
  correlationId  String?
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAfter DateTime     @default(now())
  /// PROCESSING kiralamasının bitişi; dolarsa mesaj başka bir işçi tarafından yeniden alınır.
  lockedUntil    DateTime?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?

  @@index([status, availableAfter])
  @@index([status, lockedUntil])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
}

model PriceHistory {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  month           DateTime @db.Date
  avgNightlyPrice Decimal  @db.Decimal(10, 2)
  demandIndex     Float    @default(50)
  createdAt       DateTime @default(now())

  @@unique([propertyId, month])
  @@index([propertyId, month])
}

enum TransferStatus {
  LISTED
  CLAIMED
  COMPLETED
  CANCELLED
}

model BookingTransfer {
  id              String         @id @default(cuid())
  bookingId       String
  booking         Booking        @relation(fields: [bookingId], references: [id])
  sellerId        String
  seller          User           @relation("transferSeller", fields: [sellerId], references: [id])
  status          TransferStatus @default(LISTED)
  askPrice        Decimal        @db.Decimal(10, 2)
  currency        String         @default("TRY")
  /// İmzalı claim linkinin SHA-256 özeti — token'ın kendisi saklanmaz.
  tokenHash       String         @unique
  expiresAt       DateTime
  listedAt        DateTime       @default(now())
  claimedById     String?
  claimedBy       User?          @relation("transferBuyer", fields: [claimedById], references: [id])
  claimedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  buyerPaymentRef String?

  @@index([status, bookingId])
  @@index([status, expiresAt])
  @@index([sellerId])
  @@index([claimedById])
}

/// Yönetici eylemleri denetim kaydı (değiştirilemez; yalnızca ekleme).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

/// Ödeme öncesi kural tabanlı risk değerlendirmesi (P1-10); admin inceleme kuyruğu.
model FraudCheck {
  id         String    @id @default(cuid())
  bookingId  String
  userId     String
  score      Int
  decision   String
  reasons    Json
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([decision, createdAt])
  @@index([bookingId])
}

/// Kanal (ARI) mesaj sırası: oda tipi başına son uygulanan sıra numarası (P1-9).
model ChannelSequence {
  roomId       String   @id
  lastSequence Int
  lastKey      String?
  updatedAt    DateTime @updatedAt
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// Tek kullanımlık e-posta doğrulama / şifre sıfırlama token'ı — yalnızca SHA-256 özeti saklanır.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

/// Passkey (WebAuthn) kimlik bilgisi; `id` = base64url credential ID.
model WebAuthnCredential {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  publicKey  Bytes
  counter    Int       @default(0)
  transports String[]  @default([])
  name       String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}
